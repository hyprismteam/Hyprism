  <Style Selector="instances|InstancesView CheckBox.logsLevelCheck">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="RowBackground"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                CornerRadius="8"
                Padding="10,9">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
          </Border.Transitions>
          <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
            <Border x:Name="SelectionIndicator"
                    Width="20" Height="20"
                    Background="#34343A"
                    CornerRadius="6">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
              </Border.Transitions>
              <PathIcon x:Name="CheckGlyph"
                        Width="11" Height="11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource CheckIcon}"
                        Foreground="#151515"
                        Opacity="0">
                <PathIcon.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                  </Transitions>
                </PathIcon.Transitions>
              </PathIcon>
            </Border>
            <ContentPresenter Grid.Column="1"
                              x:Name="CheckLabel"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              VerticalContentAlignment="Center">
              <ContentPresenter.Transitions>
                <Transitions>
                  <BrushTransition Property="Foreground" Duration="0:0:0.16" />
                </Transitions>
              </ContentPresenter.Transitions>
            </ContentPresenter>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView CheckBox.logsLevelCheck:pointerover /template/ Border#RowBackground">
    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
  </Style>

  <Style Selector="instances|InstancesView CheckBox.logsLevelCheck:pointerover /template/ ContentPresenter#CheckLabel">
