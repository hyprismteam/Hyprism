<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Hyprism.Desktop.Controls"
        xmlns:easing="using:Avalonia.Animation.Easings"
        xmlns:instances="using:Hyprism.Desktop.Screens.Instances">
  <!-- Selectors owned by the Instances screen -->

  <Style Selector="instances|InstancesView">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Grid.instancesPage">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Border.instancesListPane">
    <Setter Property="Background" Value="{DynamicResource NavigationPaneBrush}" />
  </Style>

  <Style Selector="instances|InstancesView.compact Border.instancesListPane">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>






  <Style Selector="instances|InstancesView Image.instancesListGameIcon">
    <Setter Property="Width" Value="0" />
    <Setter Property="Height" Value="0" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="instances|InstancesView.compact Image.instancesListGameIcon">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="IsVisible" Value="True" />
  </Style>













  <Style Selector="instances|InstancesView Border.instancesDetails">
    <Setter Property="Background" Value="{DynamicResource NavigationPaneBrush}" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>






  <Style Selector="instances|InstancesView Border.instancesVersionPicker">
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>

  <Style Selector="instances|InstancesView Path.instancesVersionSpinner">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="instances|InstancesView.compact StackPanel.managerWideActions">
    <Setter Property="IsVisible" Value="False" />
  </Style>


  <Style Selector="instances|InstancesView Image.instanceGameIcon">
    <Setter Property="Width" Value="144" />
    <Setter Property="Height" Value="144" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="instances|InstancesView.compact Image.instanceGameIcon">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="instances|InstancesView Image.compactInstanceGameIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>









  <Style Selector="instances|InstancesView Button.managerCompactActionPart.main.active.cancelArmed:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerActionBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>


  <Style Selector="instances|InstancesView Button.managerCompactActionPart.menu.actionActive">
    <Setter Property="Width" Value="0" />
    <Setter Property="Opacity" Value="0" />
  </Style>






















  <Style Selector="instances|InstancesView Button.managerAction.primary.active.cancelArmed:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerActionBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>













  <Style Selector="instances|InstancesView Button.managerCompactActionPart.main.active Grid.managedActionContent">
    <Setter Property="Width" Value="190" />
    <Setter Property="MinWidth" Value="190" />
    <Setter Property="MaxWidth" Value="190" />
  </Style>









  <Style Selector="instances|InstancesView Path.managedActionIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>


  <Style Selector="instances|InstancesView TextBlock.managedActionMetric">
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>








  <Style Selector="instances|InstancesView Border.instanceDeleteConfirmation">
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceConfirmAction">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceConfirmAction.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="#111111" />
  </Style>






  <Style Selector="instances|InstancesView Border.instanceMenuGroup">
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="instances|InstancesView TextBlock.instanceMenuTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="instances|InstancesView TextBlock.instanceMenuDescription">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxLines" Value="2" />
  </Style>

  <Style Selector="instances|InstancesView Path.instanceMenuChevron">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="instances|InstancesView Image.instanceMenuIcon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="instances|InstancesView Path.instancePlaceholderIcon">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceContentPanel">
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceContentPanel.catalog">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="instances|InstancesView TextBox.instanceSearch">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView TextBox.instanceSearch:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
  </Style>

  <Style Selector="instances|InstancesView TextBox.instanceSearch:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
  </Style>

  <Style Selector="instances|InstancesView TextBox.logsSearch">
    <Setter Property="Padding" Value="44,9,12,9" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView TextBox.logsSearch /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView TextBox.logsSearch:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="instances|InstancesView TextBox.logsSearch:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceActiveBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="instances|InstancesView Path.logsSearchIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="instances|InstancesView TextBox.instanceSearch.catalogSearch">
    <Setter Property="Padding" Value="12,0,48,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="instances|InstancesView TextBox.instanceSearch.catalogSearch:focus">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="instances|InstancesView Button.modCatalogSearchAction">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="scale(0.82)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
          <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView Button.modCatalogSearchAction.visible">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="instances|InstancesView Button.modCatalogSearchAction.hidden">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="RenderTransform" Value="scale(0.82)" />
  </Style>

  <Style Selector="instances|InstancesView Button.modCatalogSearchAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.06)" />
  </Style>

  <Style Selector="instances|InstancesView Button.modCatalogSearchAction:pressed">
    <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>

  <Style Selector="instances|InstancesView Path.modCatalogSearchSpinner">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="instances|InstancesView Path.modCatalogSearchSpinner.loading">
    <Style.Animations>
      <Animation Duration="0:0:0.8" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarAction">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarAction.primarySmall">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#111111" />
  </Style>

  <Style Selector="instances|InstancesView Border.catalogInstallTopBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransformOrigin" Value="100%,50%" />
    <Setter Property="RenderTransform" Value="scale(0.94) translateX(10px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
          <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView Border.catalogInstallTopBar.visible">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1) translateX(0px)" />
  </Style>

  <Style Selector="instances|InstancesView Border.catalogInstallTopBar.hidden">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scale(0.94) translateX(10px)" />
  </Style>

  <Style Selector="instances|InstancesView Border.logsShowFolderAction">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransformOrigin" Value="100%,50%" />
    <Setter Property="RenderTransform" Value="scale(0.94) translateX(10px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
          <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView Border.logsShowFolderAction.visible">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1) translateX(0px)" />
  </Style>

  <Style Selector="instances|InstancesView Border.logsShowFolderAction.hidden">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="scale(0.94) translateX(10px)" />
  </Style>

  <Style Selector="instances|InstancesView Button.catalogInstallTopBarAction">
    <Setter Property="Width" Value="126" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceModRow">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView Border.instanceModRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceVirtualizedList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <VirtualizingStackPanel CacheLength="1" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceVirtualizedList > ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceVirtualizedList > ListBoxItem:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceVirtualizedList > ListBoxItem:selected">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceModIcon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceModState">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceModState.enabled">
    <Setter Property="Background" Value="#1735A85B" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceModState TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceModState.enabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceInstall">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="#111111" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceInstall:disabled">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarIconButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarIconButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarIconButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarIconButton Path.instanceToolbarIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarIconButton:pointerover Path.instanceToolbarIcon">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Button.instanceToolbarIconButton.update Path.instanceToolbarIcon">
    <Setter Property="Fill" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Path.instanceToolbarSpinner">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="instances|InstancesView Path.instanceButtonSpinner">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>

  <Style Selector="instances|InstancesView Path.instanceButtonSpinner.light">
    <Setter Property="Stroke" Value="#111111" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceBadge">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceBadge TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceBadge.update">
    <Setter Property="Background" Value="#1735A85B" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceBadge.update TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceAlertBar">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="instances|InstancesView Border.instanceAlertBar TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
