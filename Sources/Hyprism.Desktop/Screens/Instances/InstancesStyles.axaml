  <Style Selector="instances|InstancesView CheckBox.instanceSelectCheck">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="SelectionIndicator"
                Width="20"
                Height="20"
                Background="#34343A"
                BorderThickness="0"
                CornerRadius="6">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.16">
                <BrushTransition.Easing><easing:CubicEaseOut /></BrushTransition.Easing>
              </BrushTransition>
            </Transitions>
          </Border.Transitions>
          <PathIcon x:Name="CheckGlyph"
                    Width="11"
                    Height="11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource CheckIcon}"
                    Foreground="#151515"
                    Opacity="0"
                    RenderTransform="scale(0.68)"
                    RenderTransformOrigin="50%,50%">
            <PathIcon.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
                  <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
              </Transitions>
            </PathIcon.Transitions>
          </PathIcon>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

