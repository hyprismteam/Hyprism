    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceLogList.wrap SelectableTextBlock.logText">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceLogList SelectableTextBlock.logText.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceLogList SelectableTextBlock.logText.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceLogList SelectableTextBlock.logText.system">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="instances|InstancesView ListBox.instanceLogList SelectableTextBlock.logText.trace">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>


</Styles>
