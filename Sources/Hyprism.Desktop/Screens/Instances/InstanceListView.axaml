<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:instances="using:Hyprism.Desktop.Screens.Instances"
             xmlns:controls="using:Hyprism.Desktop.Controls"
             xmlns:easing="using:Avalonia.Animation.Easings"
             x:Class="Hyprism.Desktop.Screens.Instances.InstanceListView"
             x:Name="InstanceListRoot"
             x:DataType="instances:InstancesViewModel">
    <Border x:Name="InstancesListPane"
            Classes="instancesListPane managerRail"
            Grid.Row="0"
            ClipToBounds="True"
            IsVisible="{Binding HasInstances}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15">
            <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
          </DoubleTransition>
        </Transitions>
      </Border.Transitions>
      <Border.RenderTransform>
        <TranslateTransform>
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="0:0:0.19">
                <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
              </DoubleTransition>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Border.RenderTransform>
      <ContentControl Classes="managerRailSurface">
        <StackPanel Classes="managerRailList">
              <ItemsControl x:Name="InstancesItems" ItemsSource="{Binding AllInstances}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Stretch" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="instances:InstanceItemViewModel">
                    <Grid Classes="managerListItemHost" Classes.menuOpen="{Binding IsMenuOpen}">
                    <Button Classes="managerRailCategory managerListItem"
                            Classes.managed="{Binding IsManaged}"
                            Click="OnInstanceClicked"
                            Command="{Binding DataContext.OpenInstanceDetailsCommand, ElementName=InstanceListRoot}"
                            CommandParameter="{Binding Id}">
                      <Grid Classes="managerListItemLayout" ColumnDefinitions="Auto,*,40" ColumnSpacing="12">
                        <Border Classes="managerListDragTarget"
                                Cursor="Arrow"
                                PointerPressed="OnInstanceDragHandlePressed"
                                PointerMoved="OnInstanceDragHandleMoved"
                                PointerReleased="OnInstanceDragHandleReleased">
                          <Path Classes="managerListHandle"
                                Data="{StaticResource DragIndicatorIcon}" />
                        </Border>
                        <Grid Grid.Column="1"
                              Classes="managerListIdentity"
                              ColumnDefinitions="Auto,*">
                          <Border Classes="instanceIconClip list" IsHitTestVisible="False">
                            <Grid Classes="instancesListGameIcon">
                              <Image Source="avares://Hyprism.Desktop/Assets/Game/grass.png"
                                     IsVisible="{Binding !HasIcon}" Stretch="Uniform" />
                              <Image Source="{Binding Icon}"
                                     IsVisible="{Binding HasIcon}" Stretch="UniformToFill" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Name}"
                                       Classes="settingsCategoryTitle managerListTitle"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding Branch}"
                                       Classes="managerCategoryDescription"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Button>
                        <Border x:Name="InstanceMoreTarget"
                                Classes="managerListMoreTarget"
                                Classes.open="{Binding IsMenuOpen}"
                                Cursor="Hand"
                                PointerPressed="OnInstanceMenuPointerPressed"
                                PointerReleased="OnToggleInstanceMenuPointerReleased">
                          <PathIcon Classes="managerListMoreIcon"
                                    Data="{StaticResource MoreVerticalIcon}" />
                        </Border>

                        <controls:FadingPopup
                                              Placement="BottomEdgeAlignedRight"
                                              PlacementTarget="InstanceMoreTarget"
                                              VerticalOffset="8"
                                              IsRequestedOpen="{Binding IsMenuOpen, Mode=TwoWay}">
                          <Border Classes="uiPopupSurface managerCompactActionFlyout">
                            <StackPanel Spacing="2">
                              <Button Classes="managerCompactMenuAction"
                                      Click="OnOpenInstanceFolderMenuClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <Path Classes="managerCompactMenuIcon" Data="{StaticResource FolderOpenIcon}" />
                                  <TextBlock Text="{Binding DataContext.ManagedInstanceOpenFolderLabel, ElementName=InstanceListRoot}"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                              <Button Classes="managerCompactMenuAction"
                                      Click="OnEditInstanceMenuClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <Path Classes="managerCompactMenuIcon" Data="{StaticResource EditRoundedIcon}" />
                                  <TextBlock Text="{Binding DataContext.EditInstanceLabel, ElementName=InstanceListRoot}"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                              <Button Classes="managerCompactMenuAction danger"
                                      IsVisible="{Binding !IsRunning}"
                                      Click="OnDeleteInstanceMenuClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                  <Path Classes="managerCompactMenuIcon" Data="{StaticResource DeleteIcon}" />
                                  <TextBlock Text="{Binding DataContext.ManagedInstanceDeleteLabel, ElementName=InstanceListRoot}"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                              </Button>
                            </StackPanel>
                          </Border>
                        </controls:FadingPopup>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Classes="formNavigationRow managerAddRow quietAction last"
                      Click="OnOpenCreatorClicked">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="9">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource AddIcon}" />
                  <TextBlock Text="{Binding NewInstanceTitle}"
                             Classes="formLabel"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
        </StackPanel>
      </ContentControl>
    </Border>
</UserControl>
