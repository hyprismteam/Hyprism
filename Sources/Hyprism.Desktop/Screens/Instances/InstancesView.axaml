<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:instances="using:Hyprism.Desktop.Screens.Instances"
             xmlns:controls="using:Hyprism.Desktop.Controls"
             xmlns:easing="using:Avalonia.Animation.Easings"
             x:Class="Hyprism.Desktop.Screens.Instances.InstancesView"
             x:Name="InstancesRoot"
             x:DataType="instances:InstancesViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Hyprism.Desktop/Screens/Instances/InstancesTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://Hyprism.Desktop/Screens/Instances/InstancesStyles.axaml" />
  </UserControl.Styles>

  <Grid x:Name="InstancesOverlayRoot">
  <Grid x:Name="InstancesLayout" Classes="instancesPage" ColumnDefinitions="Auto,*" RowDefinitions="*">
    <Grid.Effect>
      <BlurEffect Radius="0">
        <BlurEffect.Transitions>
          <Transitions>
            <DoubleTransition Property="Radius" Duration="0:0:0.2">
              <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
            </DoubleTransition>
          </Transitions>
        </BlurEffect.Transitions>
      </BlurEffect>
    </Grid.Effect>
    <Border x:Name="InstancesListPane"
            Classes="instancesListPane"
            Grid.Row="0"
            Width="276"
            ClipToBounds="True"
            IsVisible="{Binding HasInstances}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15">
            <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
          </DoubleTransition>
        </Transitions>
      </Border.Transitions>
      <Border.RenderTransform>
        <TranslateTransform>
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="0:0:0.19">
                <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
              </DoubleTransition>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Border.RenderTransform>
      <Grid MinWidth="276">
        <controls:SmoothScrollViewer Classes="instancesScroll"
                      Margin="14,18,4,18"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Classes="instancesListGroup"
                      Margin="0,0,10,0"
                      Spacing="2">
              <ItemsControl x:Name="InstancesItems" ItemsSource="{Binding AllInstances}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Stretch" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="instances:InstanceItemViewModel">
                    <Button Classes="managerRailCategory managerListItem"
                            Classes.managed="{Binding IsManaged}"
                            Click="OnInstanceClicked"
                            Command="{Binding DataContext.OpenInstanceDetailsCommand, ElementName=InstancesRoot}"
                            CommandParameter="{Binding Id}">
                      <Grid Classes="managerListItemLayout" ColumnDefinitions="Auto,*,22" ColumnSpacing="12">
                        <Border Classes="managerListDragTarget"
                                Cursor="Arrow"
                                PointerPressed="OnInstanceDragHandlePressed"
                                PointerMoved="OnInstanceDragHandleMoved"
                                PointerReleased="OnInstanceDragHandleReleased">
                          <Path Classes="managerListHandle"
                                Data="{StaticResource DragIndicatorIcon}" />
                        </Border>
                        <Grid Grid.Column="1"
                              Classes="managerListIdentity"
                              ColumnDefinitions="Auto,*">
                          <Image Classes="instancesListGameIcon"
                                 Source="avares://Hyprism.Desktop/Assets/Game/grass.png"
                                 Stretch="Uniform"
                                 IsHitTestVisible="False" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Name}"
                                       Classes="settingsCategoryTitle managerListTitle"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding Branch}"
                                       Classes="managerCategoryDescription"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                          </StackPanel>
                        </Grid>
                        <Path Grid.Column="2"
                              Classes="managerListMore"
                              Data="{StaticResource MoreVerticalIcon}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Classes="formNavigationRow managerAddRow last"
                      Click="OnOpenCreatorClicked">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="9">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource AddIcon}" />
                  <TextBlock Text="{Binding NewInstanceTitle}"
                             Classes="formLabel"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
          </StackPanel>
        </controls:SmoothScrollViewer>
      </Grid>
    </Border>

    <Grid x:Name="InstancesContent"
          Grid.Column="1"
          Grid.Row="0"
          ClipToBounds="True"
          Background="{DynamicResource SurfaceBrush}"
          ZIndex="1">
      <Grid.RenderTransform>
        <TranslateTransform>
          <TranslateTransform.Transitions>
            <Transitions>
              <DoubleTransition Property="X" Duration="0:0:0.3">
                <DoubleTransition.Easing>
                  <easing:CubicEaseInOut />
                </DoubleTransition.Easing>
              </DoubleTransition>
            </Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Grid.RenderTransform>
      <Grid x:Name="InstancesOverview">
        <Grid.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18">
              <DoubleTransition.Easing>
                <easing:CubicEaseInOut />
              </DoubleTransition.Easing>
            </DoubleTransition>
          </Transitions>
        </Grid.Transitions>
        <Grid.RenderTransform>
          <TranslateTransform>
            <TranslateTransform.Transitions>
              <Transitions>
                <DoubleTransition Property="X" Duration="0:0:0.18">
                  <DoubleTransition.Easing>
                    <easing:CubicEaseInOut />
                  </DoubleTransition.Easing>
                </DoubleTransition>
              </Transitions>
            </TranslateTransform.Transitions>
          </TranslateTransform>
        </Grid.RenderTransform>
        <controls:EmptyState IsVisible="{Binding !HasInstances}"
                             Classes="instancesEmptyState"
                             Title="{Binding CreateInstanceTitle}"
                             Description="{Binding CreateInstanceHint}">
          <controls:EmptyState.Icon>
            <Image Width="56"
                   Height="56"
                   Source="avares://Hyprism.Desktop/Assets/Fluent/puzzle.png"
                   Stretch="Uniform" />
          </controls:EmptyState.Icon>
          <controls:EmptyState.ActionContent>
            <Button Classes="primary"
                    Click="OnOpenCreatorClicked">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="actionIcon" Width="18" Height="18" Stretch="Uniform" Data="{StaticResource GestureSelectIcon}" />
                <TextBlock Text="{Binding SelectVersionLabel}" />
              </StackPanel>
            </Button>
          </controls:EmptyState.ActionContent>
        </controls:EmptyState>

        <Grid IsVisible="{Binding HasInstances}" ClipToBounds="True">
          <Grid x:Name="InstanceHubScreen" RowDefinitions="Auto,*">
            <Grid.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                  <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
                </DoubleTransition>
              </Transitions>
            </Grid.Transitions>
            <Grid.RenderTransform>
              <TranslateTransform>
                <TranslateTransform.Transitions>
                  <Transitions>
                    <DoubleTransition Property="X" Duration="0:0:0.18">
                      <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
                    </DoubleTransition>
                  </Transitions>
                </TranslateTransform.Transitions>
              </TranslateTransform>
            </Grid.RenderTransform>

            <Border x:Name="CompactInstanceToolbar"
                    Classes="detailToolbar compact scrolled"
                    IsVisible="False">
              <Grid ColumnDefinitions="*,Auto,*">
                <Button Classes="detailBack" HorizontalAlignment="Left" Click="OnCompactInstanceBackClicked">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource NextIcon}">
                      <Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform>
                    </Path>
                    <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <Image Classes="compactInstanceGameIcon"
                         Source="avares://Hyprism.Desktop/Assets/Game/grass.png"
                         Stretch="Uniform" />
                  <TextBlock Classes="detailToolbarTitle"
                             Text="{Binding ManagedInstanceName}"
                             MaxWidth="240"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis"
                             FontSize="16"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2"
                        Classes="managerCompactSplitAction"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                  <Grid ColumnDefinitions="Auto,Auto">
                    <Button x:Name="CompactInstancePrimaryAction"
                            Classes="managerCompactActionPart main"
                            Classes.active="{Binding IsManagedInstanceActionActive}"
                            Classes.cancelArmed="{Binding IsManagedInstanceCancellationArmed}"
                            IsEnabled="{Binding CanRunManagedInstanceAction}"
                            PointerExited="OnManagedInstanceActionPointerExited"
                            Command="{Binding RunManagedInstanceCommand}">
                      <ContentControl Content="{Binding}"
                                      ContentTemplate="{StaticResource ManagedInstanceActionTemplate}" />
                    </Button>

                    <Button x:Name="CompactInstanceMoreButton"
                            Grid.Column="1"
                            Classes="managerCompactActionPart menu"
                            Classes.actionActive="{Binding IsManagedInstanceActionActive}"
                            IsEnabled="{Binding CanDeleteManagedInstance}"
                            Click="OnToggleCompactInstanceMenuClicked">
                      <PathIcon Classes="managerCompactActionChevron"
                                Data="{StaticResource ExpandMoreIcon}" />
                    </Button>

                    <controls:FadingPopup x:Name="CompactInstanceMenuPopup"
                                          Grid.Column="1"
                                          Placement="BottomEdgeAlignedRight"
                                          PlacementTarget="CompactInstanceMoreButton"
                                          VerticalOffset="8">
                      <Border Classes="uiPopupSurface managerCompactActionFlyout">
                        <StackPanel Spacing="2">
                          <Button Classes="managerCompactMenuAction"
                                  IsEnabled="{Binding CanOpenManagedInstanceFolder}"
                                  Command="{Binding OpenManagedInstanceFolderCommand}"
                                  Click="OnCloseCompactInstanceMenuClicked">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <Path Classes="managerCompactMenuIcon"
                                    Data="{StaticResource FolderOpenIcon}" />
                              <TextBlock Text="{Binding ManagedInstanceOpenFolderLabel}"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>

                          <Button x:Name="CompactDeleteInstanceButton"
                                  Classes="managerCompactMenuAction danger"
                                  IsEnabled="{Binding CanDeleteManagedInstance}">
                            <Button.Flyout>
                              <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Classes="instanceDeleteConfirmation">
                                  <StackPanel Width="300" Spacing="12">
                                    <TextBlock Text="{Binding ManagedInstanceDeleteTitle}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ManagedInstanceDeleteHint}"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8">
                                      <Button Classes="instanceConfirmAction"
                                              Click="OnCloseDeleteInstanceFlyoutClicked">
                                        <TextBlock Text="{Binding CancelLabel}" />
                                      </Button>
                                      <Button Classes="instanceConfirmAction danger"
                                              Command="{Binding DeleteManagedInstanceCommand}"
                                              Click="OnCloseDeleteInstanceFlyoutClicked">
                                        <TextBlock Text="{Binding ManagedInstanceDeleteLabel}" />
                                      </Button>
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                              </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <Path Classes="managerCompactMenuIcon"
                                    Data="{StaticResource DeleteIcon}" />
                              <TextBlock Text="{Binding ManagedInstanceDeleteLabel}"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Border>
                    </controls:FadingPopup>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <controls:SmoothScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Classes="instanceHubContent"
                          x:Name="InstanceHubContent"
                          Margin="32,28,32,40"
                          MaxWidth="720"
                          HorizontalAlignment="Stretch"
                          Spacing="22">
                <StackPanel Classes="instanceSummary" Spacing="22">
                  <Image Classes="instanceGameIcon"
                         Source="avares://Hyprism.Desktop/Assets/Game/grass.png"
                         Stretch="Uniform" />

                  <Border Classes="managerWideSplitAction"
                          HorizontalAlignment="Center">
                    <StackPanel x:Name="WideInstanceActions"
                                Classes="managerActions managerWideActions"
                                Classes.actionActive="{Binding IsManagedInstanceActionActive}"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="0">
                  <Button Classes="managerAction primary first"
                          Classes.active="{Binding IsManagedInstanceActionActive}"
                          Classes.cancelArmed="{Binding IsManagedInstanceCancellationArmed}"
                          IsEnabled="{Binding CanRunManagedInstanceAction}"
                          PointerExited="OnManagedInstanceActionPointerExited"
                          Command="{Binding RunManagedInstanceCommand}">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource ManagedInstanceActionTemplate}" />
                  </Button>

                  <Border Classes="managerWideActionDivider" />

                  <Button Classes="managerAction secondary middle"
                          IsEnabled="{Binding CanOpenManagedInstanceFolder}"
                          Command="{Binding OpenManagedInstanceFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="managerActionIcon" Data="{StaticResource FolderOpenIcon}" />
                      <TextBlock Text="{Binding ManagedInstanceOpenFolderLabel}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Border Classes="managerWideActionDivider deleteDivider" />

                  <Button x:Name="DeleteInstanceButton"
                          Classes="managerAction secondary danger last deleteAction"
                          IsEnabled="{Binding CanDeleteManagedInstance}">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedRight">
                        <Border Classes="instanceDeleteConfirmation">
                          <StackPanel Width="300" Spacing="12">
                            <TextBlock Text="{Binding ManagedInstanceDeleteTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ManagedInstanceDeleteHint}"
                                       Classes="muted"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                              <Button Classes="instanceConfirmAction"
                                      Click="OnCloseDeleteInstanceFlyoutClicked">
                                <TextBlock Text="{Binding CancelLabel}" />
                              </Button>
                              <Button Classes="instanceConfirmAction danger"
                                      Command="{Binding DeleteManagedInstanceCommand}"
                                      Click="OnCloseDeleteInstanceFlyoutClicked">
                                <TextBlock Text="{Binding ManagedInstanceDeleteLabel}" />
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </Flyout>
                    </Button.Flyout>
                    <StackPanel Classes="managerDeleteActionContent"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                      <Path Classes="managerActionIcon" Data="{StaticResource DeleteIcon}" />
                      <TextBlock Text="{Binding ManagedInstanceDeleteLabel}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    </Button>
                    </StackPanel>
                  </Border>

                  <Border Classes="managerInfoGroup">
                  <Grid ColumnDefinitions="*,2,*" RowDefinitions="Auto,2,Auto">
                    <Border Classes="managerInfoCell">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding InstanceStatusInfoLabel}" Classes="managerInfoLabel" />
                        <TextBlock Text="{Binding ManagedInstanceState}" Classes="managerInfoValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" />
                    <Border Grid.Column="2" Classes="managerInfoCell">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding InstancePlayTimeInfoLabel}" Classes="managerInfoLabel" />
                        <TextBlock Text="{Binding ManagedInstancePlayTime}" Classes="managerInfoValue" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" />

                    <Border Grid.Row="2" Classes="managerInfoCell">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding VersionLabel}" Classes="managerInfoLabel" />
                        <TextBlock Text="{Binding ManagedInstanceVersion}" Classes="managerInfoValue" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" />
                    <Border Grid.Row="2" Grid.Column="2" Classes="managerInfoCell">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding BranchLabel}" Classes="managerInfoLabel" />
                        <TextBlock Text="{Binding ManagedInstanceBranch}" Classes="managerInfoValue" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  </Border>
                </StackPanel>

                <Border Classes="instanceMenuGroup">
                  <StackPanel>
                    <Button Classes="formNavigationRow instanceMenuRow"
                            IsEnabled="{Binding IsManagedInstanceInstalled}"
                            Command="{Binding SelectInstanceSectionCommand}"
                            CommandParameter="mods">
                      <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="14">
                        <Image Classes="instanceMenuIcon"
                               Source="avares://Hyprism.Desktop/Assets/Fluent/puzzle.png"
                               Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding InstanceModsTitle}" Classes="formLabel instanceMenuTitle" />
                          <TextBlock Text="{Binding InstanceModsHint}" Classes="formHint instanceMenuDescription" />
                        </StackPanel>
                        <Path Grid.Column="2" Classes="instanceMenuChevron" Data="{StaticResource NextIcon}" />
                      </Grid>
                    </Button>
                    <Button Classes="formNavigationRow instanceMenuRow"
                            IsEnabled="{Binding IsManagedInstanceInstalled}"
                            Command="{Binding SelectInstanceSectionCommand}"
                            CommandParameter="browse">
                      <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="14">
                        <Image Classes="instanceMenuIcon"
                               Source="avares://Hyprism.Desktop/Assets/Fluent/compass.png"
                               Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding InstanceBrowseTitle}" Classes="formLabel instanceMenuTitle" />
                          <TextBlock Text="{Binding InstanceBrowseHint}" Classes="formHint instanceMenuDescription" />
                        </StackPanel>
                        <Path Grid.Column="2" Classes="instanceMenuChevron" Data="{StaticResource NextIcon}" />
                      </Grid>
                    </Button>
                    <Button Classes="formNavigationRow instanceMenuRow"
                            IsEnabled="{Binding IsManagedInstanceInstalled}"
                            Command="{Binding SelectInstanceSectionCommand}"
                            CommandParameter="worlds">
                      <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="14">
                        <Image Classes="instanceMenuIcon"
                               Source="avares://Hyprism.Desktop/Assets/Fluent/map.png"
                               Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding InstanceWorldsTitle}" Classes="formLabel instanceMenuTitle" />
                          <TextBlock Text="{Binding InstanceWorldsHint}" Classes="formHint instanceMenuDescription" />
                        </StackPanel>
                        <Path Grid.Column="2" Classes="instanceMenuChevron" Data="{StaticResource NextIcon}" />
                      </Grid>
                    </Button>
                    <Button Classes="formNavigationRow instanceMenuRow"
                            IsEnabled="{Binding IsManagedInstanceInstalled}"
                            Command="{Binding SelectInstanceSectionCommand}"
                            CommandParameter="console">
                      <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="14">
                        <Image Classes="instanceMenuIcon"
                               Source="avares://Hyprism.Desktop/Assets/Fluent/console.png"
                               Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding InstanceConsoleTitle}" Classes="formLabel instanceMenuTitle" />
                          <TextBlock Text="{Binding InstanceConsoleHint}" Classes="formHint instanceMenuDescription" />
                        </StackPanel>
                        <Path Grid.Column="2" Classes="instanceMenuChevron" Data="{StaticResource NextIcon}" />
                      </Grid>
                    </Button>
                    <Button Classes="formNavigationRow instanceMenuRow last"
                            IsEnabled="{Binding IsManagedInstanceInstalled}"
                            Command="{Binding SelectInstanceSectionCommand}"
                            CommandParameter="logs">
                      <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="14">
                        <Image Classes="instanceMenuIcon"
                               Source="avares://Hyprism.Desktop/Assets/Fluent/log.png"
                               Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <TextBlock Text="{Binding InstanceLogsTitle}" Classes="formLabel instanceMenuTitle" />
                          <TextBlock Text="{Binding InstanceLogsHint}" Classes="formHint instanceMenuDescription" />
                        </StackPanel>
                        <Path Grid.Column="2" Classes="instanceMenuChevron" Data="{StaticResource NextIcon}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </Border>

              </StackPanel>
            </controls:SmoothScrollViewer>
          </Grid>

          <Grid x:Name="InstanceSectionScreen"
                IsVisible="False"
                Opacity="0"
                RowDefinitions="Auto,*"
                Background="{DynamicResource SurfaceBrush}"
                ZIndex="2">
            <Grid.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                  <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
                </DoubleTransition>
              </Transitions>
            </Grid.Transitions>
            <Grid.RenderTransform>
              <TranslateTransform X="28">
                <TranslateTransform.Transitions>
                  <Transitions>
                    <DoubleTransition Property="X" Duration="0:0:0.18">
                      <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
                    </DoubleTransition>
                  </Transitions>
                </TranslateTransform.Transitions>
              </TranslateTransform>
            </Grid.RenderTransform>

            <Border Classes="detailToolbar compact scrolled">
              <Grid ColumnDefinitions="*,Auto,*">
                <Button Classes="detailBack"
                        HorizontalAlignment="Left"
                        Command="{Binding CloseInstanceSectionCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource NextIcon}">
                      <Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform>
                    </Path>
                    <TextBlock Text="{Binding InstanceContentBackLabel}" />
                  </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Classes="detailToolbarTitle"
                           Text="{Binding DisplayedInstanceSectionTitle}"
                           Margin="12,0"
                           MaxWidth="280"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <Border Grid.Column="2"
                        Classes="managerCompactSplitAction catalogInstallTopBar"
                        Classes.visible="{Binding CanOpenModCatalogInstallConfirmation}"
                        Classes.hidden="{Binding !CanOpenModCatalogInstallConfirmation}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsDisplayedInstanceBrowseSection}"
                        IsHitTestVisible="{Binding CanOpenModCatalogInstallConfirmation}">
                  <Button Classes="managerCompactActionPart main catalogInstallTopBarAction"
                          IsEnabled="{Binding CanOpenModCatalogInstallConfirmation}"
                          Command="{Binding OpenModCatalogInstallConfirmationCommand}">
                    <TextBlock Text="{Binding InstallLabel}"
                               VerticalAlignment="Center" />
                  </Button>
                </Border>
              </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,18,24,28">
              <Grid x:Name="InstalledModsSection"
                    IsVisible="{Binding IsDisplayedInstanceModsSection}"
                    MaxWidth="{x:Static controls:AdaptiveMasterDetailHost.DefaultContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="instanceSearch" PlaceholderText="{Binding InstanceModsSearchHint}" Text="{Binding InstalledModsSearchQuery, Mode=TwoWay}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="instanceToolbarIconButton"
                            Command="{Binding ImportModsCommand}"
                            ToolTip.Tip="{Binding InstanceModsAddLabel}">
                      <Path Classes="instanceToolbarIcon" Data="{StaticResource AddIcon}" />
                    </Button>
                    <Button Classes="instanceToolbarIconButton update"
                            IsEnabled="{Binding !IsCheckingModUpdates}"
                            Command="{Binding CheckModUpdatesCommand}"
                            ToolTip.Tip="{Binding InstanceModsCheckUpdatesLabel}">
                      <Grid>
                        <Path x:Name="ModUpdateCheckSpinner"
                              Classes="instanceToolbarSpinner"
                              Data="M9,1 A8,8 0 1 1 1,9"
                              IsVisible="{Binding IsCheckingModUpdates}"
                              controls:RotatingVisual.IsActive="{Binding IsCheckingModUpdates}" />
                        <Path Classes="instanceToolbarIcon"
                              Data="{StaticResource DownloadIcon}"
                              IsVisible="{Binding !IsCheckingModUpdates}" />
                        <Border Classes="instanceBadge update"
                                IsVisible="{Binding HasModUpdates}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-6,-6,0">
                          <TextBlock Text="{Binding ModUpdateCountText}" />
                        </Border>
                      </Grid>
                    </Button>
                    <Button Classes="instanceToolbarIconButton"
                            IsEnabled="{Binding !IsInstanceModsLoading}"
                            Command="{Binding RefreshInstanceModsCommand}"
                            ToolTip.Tip="{Binding RefreshLabel}">
                      <Grid>
                        <Path Classes="instanceToolbarSpinner"
                              Data="M9,1 A8,8 0 1 1 1,9"
                              IsVisible="{Binding IsInstanceModsLoading}"
                              controls:RotatingVisual.IsActive="{Binding IsInstanceModsLoading}" />
                        <Path Classes="instanceToolbarIcon"
                              Data="{StaticResource RefreshIcon}"
                              IsVisible="{Binding !IsInstanceModsLoading}" />
                      </Grid>
                    </Button>
                  </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                  <Border Classes="instanceAlertBar"
                          IsVisible="{Binding HasModUpdates}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding InstanceModsUpdatesAvailableText}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1"
                              Classes="instanceToolbarAction primarySmall"
                              IsEnabled="{Binding !IsApplyingModUpdates}"
                              Command="{Binding UpdateAllModsWithUpdatesCommand}">
                        <Grid>
                          <TextBlock Text="{Binding InstanceModsUpdateAllLabel}" IsVisible="{Binding !IsApplyingModUpdates}" />
                          <Path Classes="instanceButtonSpinner light"
                                Data="M9,1 A8,8 0 1 1 1,9"
                                IsVisible="{Binding IsApplyingModUpdates}"
                                controls:RotatingVisual.IsActive="{Binding IsApplyingModUpdates}" />
                        </Grid>
                      </Button>
                    </Grid>
                  </Border>

                  <Border Classes="instanceAlertBar selection"
                          IsVisible="{Binding HasModSelection}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding SelectedModCountText}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                      <Button Grid.Column="1" Classes="instanceBulkAction" Command="{Binding EnableSelectedModsCommand}">
                        <TextBlock Text="{Binding InstanceModsEnableSelectedLabel}" />
                      </Button>
                      <Button Grid.Column="2" Classes="instanceBulkAction" Command="{Binding DisableSelectedModsCommand}">
                        <TextBlock Text="{Binding InstanceModsDisableSelectedLabel}" />
                      </Button>
                      <Button Grid.Column="3" Classes="instanceBulkAction danger" Command="{Binding DeleteSelectedModsCommand}">
                        <TextBlock Text="{Binding InstanceModsDeleteSelectedLabel}" />
                      </Button>
                      <Button Grid.Column="5" Classes="instanceBulkAction" Command="{Binding ClearInstalledModsSelectionCommand}">
                        <TextBlock Text="{Binding InstanceModsClearSelectionLabel}" />
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>

                <Border Grid.Row="2" Classes="instanceContentPanel">
                  <Grid x:Name="ModsDropZone">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar IsVisible="{Binding IsInstanceModsLoading}" IsIndeterminate="True" Width="180" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel IsVisible="{Binding IsInstalledModsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                      <Image Width="48" Height="48" Source="avares://Hyprism.Desktop/Assets/Fluent/puzzle.png" />
                      <TextBlock Text="{Binding InstanceModsEmptyTitle}" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" />
                      <TextBlock Text="{Binding InstanceModsEmptyHint}" Classes="muted" MaxWidth="390" TextAlignment="Center" TextWrapping="Wrap" />
                      <Button Classes="instanceToolbarAction primarySmall"
                              HorizontalAlignment="Center"
                              Margin="0,6,0,0"
                              Command="{Binding SelectInstanceSectionCommand}"
                              CommandParameter="browse">
                        <TextBlock Text="{Binding InstanceBrowseTitle}" />
                      </Button>
                    </StackPanel>
                    <ListBox IsVisible="{Binding HasInstalledMods}"
                             ItemsSource="{Binding VisibleInstalledMods}"
                             Classes="instanceVirtualizedList"
                             Margin="10,10,10,0">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="instances:InstanceModItemViewModel">
                          <Border Classes="instanceModRow"
                                  Classes.selected="{Binding IsSelected}"
                                  Classes.disabled="{Binding !IsEnabled}">
                            <Grid ColumnDefinitions="Auto,44,*,Auto,Auto" ColumnSpacing="12">
                              <CheckBox Classes="instanceSelectCheck"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                              <Panel Grid.Column="1">
                                <Border Classes="instanceModIcon" IsVisible="{Binding !IsBusy}">
                                  <Panel>
                                    <TextBlock Text="{Binding Initial}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               IsVisible="{Binding !ShowsIcon}" />
                                    <Image Source="{Binding Icon}"
                                           IsVisible="{Binding ShowsIcon}"
                                           Stretch="UniformToFill"
                                           ClipToBounds="True" />
                                  </Panel>
                                </Border>
                                <Path Classes="instanceRowSpinner"
                                      Data="M9,1 A8,8 0 1 1 1,9"
                                      IsVisible="{Binding IsBusy}"
                                      controls:RotatingVisual.IsActive="{Binding IsBusy}" />
                              </Panel>
                              <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <Button Classes="instanceModNameLink"
                                          Command="{Binding DataContext.OpenInstalledModPageCommand, ElementName=InstancesRoot}"
                                          CommandParameter="{Binding}"
                                          ToolTip.Tip="{Binding DataContext.InstanceModsOpenPageTooltip, ElementName=InstancesRoot}">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               MaxWidth="320"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                  </Button>
                                  <Border Classes="instanceBadge update" IsVisible="{Binding ShowsUpdateBadge}">
                                    <TextBlock Text="{Binding UpdateBadgeText}" />
                                  </Border>
                                  <Border Classes="instanceBadge release" IsVisible="{Binding ShowsReleaseBadge}">
                                    <TextBlock Text="{Binding ReleaseBadge}" />
                                  </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" />
                                  <TextBlock Text="·" Classes="muted" FontSize="12" />
                                  <TextBlock Text="{Binding Author}" Classes="muted" FontSize="12" />
                                </StackPanel>
                              </StackPanel>
                              <ToggleSwitch Grid.Column="3"
                                            Classes="uiToggle instanceModToggle"
                                            IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                            IsEnabled="{Binding CanInteract}"
                                            Command="{Binding DataContext.ToggleModCommand, ElementName=InstancesRoot}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding DataContext.InstanceModsToggleTooltip, ElementName=InstancesRoot}" />
                              <Button Grid.Column="4"
                                      x:Name="InstalledModDeleteButton"
                                      Classes="instanceRowIconButton"
                                      ToolTip.Tip="{Binding DataContext.InstanceModsDeleteTooltip, ElementName=InstancesRoot}">
                                <Button.Flyout>
                                  <Flyout Placement="LeftEdgeAlignedTop">
                                    <Border Classes="instanceDeleteConfirmation">
                                      <StackPanel Width="240" Spacing="10">
                                        <TextBlock Text="{Binding DataContext.InstanceModsDeleteTitle, ElementName=InstancesRoot}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DataContext.InstanceModsDeleteHint, ElementName=InstancesRoot}"
                                                   Classes="muted"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                          <Button Classes="instanceConfirmAction"
                                                  Click="OnCloseModDeleteFlyoutClicked">
                                            <TextBlock Text="{Binding DataContext.CancelLabel, ElementName=InstancesRoot}" />
                                          </Button>
                                          <Button Classes="instanceConfirmAction danger"
                                                  Command="{Binding DataContext.DeleteModCommand, ElementName=InstancesRoot}"
                                                  CommandParameter="{Binding}"
                                                  Click="OnCloseModDeleteFlyoutClicked">
                                            <TextBlock Text="{Binding DataContext.InstanceModsDeleteLabel, ElementName=InstancesRoot}" />
                                          </Button>
                                        </StackPanel>
                                      </StackPanel>
                                    </Border>
                                  </Flyout>
                                </Button.Flyout>
                                <Path Classes="instanceRowIcon" Data="{StaticResource DeleteIcon}" />
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" Classes="instanceListFooter" IsVisible="{Binding HasInstalledMods}">
                      <TextBlock Text="{Binding InstanceModsFooterText}" Classes="muted" FontSize="12" />
                    </Border>
                    <Border x:Name="ModDropOverlay"
                            Grid.RowSpan="2"
                            Classes="instanceDropOverlay"
                            IsVisible="False">
                      <StackPanel HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Spacing="10">
                        <Path Classes="instanceDropIcon" Data="{StaticResource DownloadIcon}" />
                        <TextBlock Text="{Binding InstanceModsDropImportLabel}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </Grid>

              <Grid x:Name="ModCatalogSection"
                    IsVisible="{Binding IsDisplayedInstanceBrowseSection}"
                    MaxWidth="{x:Static instances:InstancesView.ModCatalogContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    RowDefinitions="Auto,*"
                    RowSpacing="10">
                <Grid x:Name="ModCatalogBrowseContent"
                      Grid.RowSpan="2"
                      RowDefinitions="Auto,*"
                      RowSpacing="10">
                  <Grid.RenderTransform>
                    <TranslateTransform />
                  </Grid.RenderTransform>
                  <Grid ColumnDefinitions="2*,*,*"
                        ColumnSpacing="8">
                  <Grid>
                    <TextBox x:Name="ModCatalogSearchBox"
                             Classes="instanceSearch catalogSearch"
                             PlaceholderText="{Binding InstanceBrowseSearchHint}"
                             Text="{Binding ModCatalogSearchQuery, Mode=TwoWay}"
                             KeyDown="OnCatalogSearchKeyDown" />
                    <Button x:Name="ModCatalogSearchButton"
                            Classes="dataPathOpen modCatalogSearchAction"
                            Classes.visible="{Binding ShouldShowModCatalogSearchAction}"
                            Classes.hidden="{Binding !ShouldShowModCatalogSearchAction}"
                            IsEnabled="{Binding CanSearchModCatalog}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding SearchModCatalogCommand}"
                            ToolTip.Tip="{Binding InstanceBrowseSearchHint}">
                      <Path Classes="dataPathOpenIcon"
                            Data="M9.5,3 A6.5,6.5 0 1 0 13.72,14.43 L19.49,20.19 L20.9,18.78 L15.14,13.02 A6.5,6.5 0 0 0 9.5,3 M9.5,5 A4.5,4.5 0 1 1 9.5,14 A4.5,4.5 0 0 1 9.5,5" />
                    </Button>
                  </Grid>
                  <controls:FadingComboBox Grid.Column="1"
                                           Classes="uiComboBox instanceFilterCombo"
                                           ItemsSource="{Binding ModCatalogCategories}"
                                           ItemTemplate="{StaticResource InstanceFilterOptionTemplate}"
                                           ItemContainerTheme="{StaticResource UiComboBoxItemTheme}"
                                           SelectedItem="{Binding SelectedModCatalogCategory, Mode=TwoWay}"
                                           PlaceholderText="{Binding InstanceBrowseCategoryLabel}"
                                           MaxDropDownHeight="280" />
                  <controls:FadingComboBox Grid.Column="2"
                                           Classes="uiComboBox instanceFilterCombo"
                                           ItemsSource="{Binding ModCatalogSortOptions}"
                                           ItemTemplate="{StaticResource InstanceFilterOptionTemplate}"
                                           ItemContainerTheme="{StaticResource UiComboBoxItemTheme}"
                                           SelectedItem="{Binding SelectedModCatalogSort, Mode=TwoWay}"
                                           PlaceholderText="{Binding InstanceBrowseSortLabel}"
                                           MaxDropDownHeight="220" />
                  </Grid>
                  <Border Grid.Row="1" Classes="instanceContentPanel catalog">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel IsVisible="{Binding IsModCatalogEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                      <Image Width="48" Height="48" Source="avares://Hyprism.Desktop/Assets/Fluent/puzzle.png" />
                      <TextBlock Text="{Binding InstanceBrowseEmptyTitle}" FontSize="19" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding InstanceBrowseEmptyHint}" Classes="muted" MaxWidth="400" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="ModCatalogList"
                             IsVisible="{Binding HasModCatalogItems}"
                             ItemsSource="{Binding ModCatalogItems}"
                             Classes="instanceVirtualizedList"
                             Margin="10,10,10,0"
                             ScrollViewer.ScrollChanged="OnModCatalogScrollChanged">
                      <ListBox.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                            <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
                          </DoubleTransition>
                        </Transitions>
                      </ListBox.Transitions>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="instances:ModCatalogItemViewModel">
                          <Border Classes="instanceModRow catalog"
                                  Classes.selected="{Binding IsSelected}"
                                  Classes.incompatible="{Binding IsIncompatible}"
                                  Cursor="Hand"
                                  Tapped="OnCatalogModPreviewRequested">
                            <Grid ColumnDefinitions="Auto,56,*,Auto" ColumnSpacing="12">
                              <CheckBox Classes="instanceSelectCheck"
                                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        IsEnabled="{Binding CanSelect}"
                                        Command="{Binding DataContext.ToggleModCatalogSelectionCommand, ElementName=InstancesRoot}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center" />
                              <Border Grid.Column="1" Classes="instanceModIcon">
                                <Panel>
                                  <TextBlock Text="{Binding Initial}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             FontWeight="Bold"
                                             IsVisible="{Binding !ShowsIcon}" />
                                  <Image Source="{Binding Icon}"
                                         IsVisible="{Binding ShowsIcon}"
                                         Stretch="UniformToFill"
                                         ClipToBounds="True" />
                                </Panel>
                              </Border>
                              <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Left"
                                           MaxWidth="360"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <Border Classes="instanceCatalogAuthorBadge">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <Border Classes="instanceCatalogAuthorAvatar">
                                        <Grid>
                                          <TextBlock Text="{Binding AuthorInitial}"
                                                     IsVisible="{Binding !ShowsAuthorAvatar}" />
                                          <Image Source="{Binding AuthorAvatar}"
                                                 IsVisible="{Binding ShowsAuthorAvatar}"
                                                 Stretch="UniformToFill" />
                                        </Grid>
                                      </Border>
                                      <TextBlock Text="{Binding Author}"
                                                 Classes="instanceCatalogAuthorName" />
                                    </StackPanel>
                                  </Border>
                                  <TextBlock Text="{Binding DownloadCountLabel}"
                                             Classes="muted"
                                             FontSize="11"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                              </StackPanel>
                              <StackPanel Grid.Column="3"
                                          Spacing="5"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                <Border Classes="instanceBadge update"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsInstalled}">
                                  <TextBlock Text="{Binding DataContext.InstalledLabel, ElementName=InstancesRoot}" />
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="ModCatalogSearchSpinner"
                            Grid.RowSpan="2"
                            ZIndex="2"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                      <Border.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="0:0:0.18">
                            <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
                          </DoubleTransition>
                        </Transitions>
                      </Border.Transitions>
                      <Path Classes="instanceToolbarSpinner modCatalogSearchSpinner"
                            Classes.loading="{Binding IsModCatalogLoading}"
                            Data="M9,1 A8,8 0 1 1 1,9"
                            RenderTransformOrigin="50%,50%">
                        <Path.RenderTransform>
                          <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                      </Path>
                    </Border>
                    <Border Grid.Row="1" Classes="instanceLoadMoreBar" IsVisible="{Binding IsLoadingMoreModCatalog}">
                      <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                        <Path Classes="instanceToolbarSpinner"
                              Data="M9,1 A8,8 0 1 1 1,9"
                              controls:RotatingVisual.IsActive="True" />
                        <TextBlock Text="{Binding InstanceBrowseLoadingMoreLabel}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  </Border>
                </Grid>

                <Border x:Name="ModCatalogInstallScreen"
                        Grid.RowSpan="2"
                        Classes="wizardScreen modCatalogInstallScreen"
                        IsVisible="False"
                        Opacity="0">
                  <Border.RenderTransform>
                    <TranslateTransform />
                  </Border.RenderTransform>
                  <controls:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="620"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Margin="28"
                                Spacing="12">
                      <TextBlock Text="{Binding ModCatalogInstallTitle}"
                                 FontSize="25"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center" />
                      <TextBlock Text="{Binding ModCatalogInstallProgressText}"
                                 Classes="muted"
                                 HorizontalAlignment="Center" />
                      <ProgressBar Value="{Binding ModCatalogInstallProgress}"
                                   Maximum="100"
                                   Height="6" />
                      <Border Classes="formGroup settingsGroup modCatalogInstallTable">
                        <StackPanel>
                          <Border Classes="dataTableHeader">
                            <Grid ColumnDefinitions="*,1.3*,1.4*" ColumnSpacing="16">
                              <TextBlock Text="{Binding ModCatalogFileNameColumn}" />
                              <TextBlock Grid.Column="1" Text="{Binding ModCatalogInstallVersionColumn}" />
                              <TextBlock Grid.Column="2" />
                            </Grid>
                          </Border>
                          <ItemsControl ItemsSource="{Binding ModCatalogInstallItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="instances:ModCatalogInstallItemViewModel">
                                <Border Classes="modCatalogInstallTableRow">
                                  <Grid ColumnDefinitions="*,1.3*,1.4*" ColumnSpacing="16">
                                    <Grid ColumnDefinitions="38,*" ColumnSpacing="16">
                                      <Border Classes="modCatalogInstallIcon">
                                        <Grid>
                                          <TextBlock Text="{Binding Initial}"
                                                     IsVisible="{Binding !ShowsIcon}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                          <Image Source="{Binding Icon}"
                                                 IsVisible="{Binding ShowsIcon}"
                                                 Stretch="UniformToFill"
                                                 ClipToBounds="True" />
                                        </Grid>
                                      </Border>
                                      <TextBlock Grid.Column="1"
                                                 Text="{Binding Name}"
                                                 Classes="dataTableValue link"
                                                 TextTrimming="CharacterEllipsis"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Version}"
                                               Classes="dataTableValue"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Spacing="5">
                                      <ProgressBar Value="{Binding Progress}"
                                                   Maximum="100"
                                                   Height="5" />
                                      <TextBlock Text="{Binding ProgressText}"
                                                 Classes="dataTableValue"
                                                 HorizontalAlignment="Right" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </controls:SmoothScrollViewer>
                </Border>
              </Grid>

              <Grid IsVisible="{Binding IsDisplayedInstanceWorldsSection}" RowDefinitions="Auto,*" RowSpacing="12">
                <Button HorizontalAlignment="Right" Classes="instanceToolbarAction" Command="{Binding RefreshInstanceWorldsCommand}" IsEnabled="{Binding !IsInstanceWorldsLoading}">
                  <TextBlock Text="{Binding RefreshLabel}" />
                </Button>
                <Border Grid.Row="1" Classes="instanceContentPanel">
                  <Grid>
                    <ProgressBar IsVisible="{Binding IsInstanceWorldsLoading}" IsIndeterminate="True" Width="180" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel IsVisible="{Binding IsInstanceWorldsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                      <Image Width="48" Height="48" Source="avares://Hyprism.Desktop/Assets/Fluent/data.png" />
                      <TextBlock Text="{Binding InstanceWorldsEmptyTitle}" FontSize="19" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding InstanceWorldsEmptyHint}" Classes="muted" MaxWidth="400" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox IsVisible="{Binding HasInstanceWorlds}"
                             ItemsSource="{Binding InstanceWorlds}"
                             Classes="instanceVirtualizedList"
                             Margin="10">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="instances:InstanceWorldItemViewModel">
                            <Border Classes="instanceModRow">
                              <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                <Border Classes="instanceModIcon"><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" /></Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding LastModified}" Classes="muted" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>

              <Grid x:Name="InstanceConsoleSection"
                    IsVisible="{Binding IsDisplayedInstanceConsoleSection}"
                    MaxWidth="{x:Static controls:AdaptiveMasterDetailHost.DefaultContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    RowDefinitions="Auto,*"
                    RowSpacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                  <Border Classes="consoleStatusPill">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Ellipse Classes="consoleStatusDot"
                               Width="8"
                               Height="8"
                               Classes.running="{Binding IsConsoleRunning}" />
                      <TextBlock Text="{Binding ConsoleStatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <TextBox Grid.Column="1"
                           Classes="instanceSearch"
                           PlaceholderText="{Binding ConsoleSearchHint}"
                           Text="{Binding ConsoleSearchQuery, Mode=TwoWay}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConsoleAutoScrollLabel}" Classes="consoleOptionLabel" />
                    <ToggleSwitch Classes="uiToggle consoleOptionToggle" IsChecked="{Binding IsConsoleAutoScroll, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="3"
                              Classes="consoleWrapOption"
                              Orientation="Horizontal"
                              Spacing="7"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConsoleWrapLabel}" Classes="consoleOptionLabel" />
                    <ToggleSwitch Classes="uiToggle consoleOptionToggle" IsChecked="{Binding IsConsoleWrap, Mode=TwoWay}" />
                  </StackPanel>
                  <Button Grid.Column="4" Classes="instanceToolbarAction" Command="{Binding ClearConsoleCommand}">
                    <TextBlock Text="{Binding ConsoleClearLabel}" />
                  </Button>
                </Grid>
                <Border Grid.Row="1" Classes="instanceContentPanel consolePanel">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0"
                             x:Name="ConsoleList"
                             Classes="instanceConsoleList"
                             Classes.wrap="{Binding IsConsoleWrap}"
                             ItemsSource="{Binding ConsoleLines}"
                             IsVisible="{Binding HasConsoleLines}"
                             Margin="10,10,10,0"
                             ScrollViewer.ScrollChanged="OnConsoleScrollChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="instances:ConsoleLineViewModel">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="consoleTime" Text="{Binding Time}" />
                            <TextBlock Classes="consoleText"
                                       Classes.error="{Binding IsError}"
                                       Classes.warning="{Binding IsWarning}"
                                       Classes.system="{Binding IsSystem}"
                                       Text="{Binding Text}" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="0"
                                IsVisible="{Binding IsConsoleEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                      <Path Classes="instancePlaceholderIcon" Data="{StaticResource ConsoleIcon}" />
                      <TextBlock Text="{Binding InstanceConsoleEmptyTitle}"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 TextAlignment="Center" />
                      <TextBlock Text="{Binding InstanceConsoleEmptyHint}"
                                 Classes="muted"
                                 MaxWidth="420"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" Classes="instanceListFooter" IsVisible="{Binding HasConsoleLines}">
                      <TextBlock Text="{Binding ConsoleLineCountText}" Classes="muted" FontSize="12" />
                    </Border>
                  </Grid>
                </Border>
              </Grid>

              <Border IsVisible="{Binding IsDisplayedInstanceLogsSection}"
                      Classes="instanceContentPanel">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                  <Path Classes="instancePlaceholderIcon" Data="{StaticResource LogsIcon}" />
                  <TextBlock Text="{Binding InstanceLogsEmptyTitle}"
                             FontSize="19"
                             FontWeight="SemiBold"
                             TextAlignment="Center" />
                  <TextBlock Text="{Binding InstanceLogsEmptyHint}"
                             Classes="muted"
                             MaxWidth="420"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding InstanceContentError}"
                         IsVisible="{Binding HasInstanceContentError}"
                         Foreground="{DynamicResource DangerSoftBrush}"
                         Background="{DynamicResource SurfaceElevatedBrush}"
                         Padding="12,8"
                         Margin="12"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Bottom"
                         TextWrapping="Wrap" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="InstanceCreatorScreen"
              Classes="wizardScreen"
              IsVisible="False"
              Opacity="0">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18">
              <DoubleTransition.Easing>
                <easing:CubicEaseInOut />
              </DoubleTransition.Easing>
            </DoubleTransition>
          </Transitions>
        </Border.Transitions>
        <Border.RenderTransform>
          <TranslateTransform X="36">
            <TranslateTransform.Transitions>
              <Transitions>
                <DoubleTransition Property="X" Duration="0:0:0.18">
                  <DoubleTransition.Easing>
                    <easing:CubicEaseInOut />
                  </DoubleTransition.Easing>
                </DoubleTransition>
              </Transitions>
            </TranslateTransform.Transitions>
          </TranslateTransform>
        </Border.RenderTransform>
        <StackPanel Classes="instancesWizardContent"
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="32"
                    Spacing="12">
            <controls:WizardRevealIcon x:Name="InstanceWizardReveal"
                                       AnimationPath="/Assets/Lotties/server-reveal.json" />
            <TextBlock Text="{Binding NewInstanceTitle}"
                       HorizontalAlignment="Center"
                       FontSize="26"
                       FontWeight="Bold"
                       TextAlignment="Center" />
            <TextBlock Text="{Binding NewInstanceHint}"
                       Classes="muted"
                       MaxWidth="460"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Border Classes="formGroup" Margin="0,16,0,0">
              <StackPanel>
                <controls:FormRow Label="{Binding BranchLabel}"
                                  Hint="{Binding InstanceBranchHint}"
                                  MinHeight="72">
                  <Border Width="236" Classes="uiSegmentedControl">
                    <Grid x:Name="BranchSwitchTrack"
                          ColumnDefinitions="*,*"
                          SizeChanged="OnBranchSwitchSizeChanged">
                      <Border x:Name="BranchSelectionIndicator"
                              Grid.Column="0"
                              Classes="uiSegmentedIndicator"
                              IsHitTestVisible="False">
                        <Border.RenderTransform>
                          <TranslateTransform>
                            <TranslateTransform.Transitions>
                              <Transitions>
                                <DoubleTransition Property="X" Duration="0:0:0.2" />
                              </Transitions>
                            </TranslateTransform.Transitions>
                          </TranslateTransform>
                        </Border.RenderTransform>
                      </Border>
                      <Button Grid.Column="0"
                              Classes="uiSegmentedItem"
                              HorizontalAlignment="Stretch"
                              Classes.selected="{Binding IsCreateReleaseBranch}"
                              Content="{Binding ReleaseLabel}"
                              Command="{Binding SetNewInstanceBranchCommand}"
                              CommandParameter="release" />
                      <Button Grid.Column="1"
                              Classes="uiSegmentedItem"
                              HorizontalAlignment="Stretch"
                              Classes.selected="{Binding IsCreatePreReleaseBranch}"
                              Content="{Binding PreReleaseLabel}"
                              Command="{Binding SetNewInstanceBranchCommand}"
                              CommandParameter="pre-release" />
                    </Grid>
                  </Border>
                </controls:FormRow>

                <controls:FormRow Classes="last"
                                  Label="{Binding VersionLabel}"
                                  Hint="{Binding InstanceVersionHint}"
                                  MinHeight="72">
                  <Border Width="236" Classes="instancesVersionPicker">
                    <Grid>
                        <controls:FadingComboBox x:Name="InstanceVersionComboBox"
                                                 Classes="uiComboBox"
                                                 ItemsSource="{Binding AvailableInstanceVersions}"
                                                 ItemTemplate="{StaticResource InstanceVersionTemplate}"
                                                 ItemContainerTheme="{StaticResource UiComboBoxItemTheme}"
                                                 SelectedItem="{Binding SelectedNewInstanceVersion, Mode=TwoWay}"
                                                 IsEnabled="{Binding HasAvailableInstanceVersions}"
                                                 MaxDropDownHeight="220">
                          <controls:FadingComboBox.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                            </Transitions>
                          </controls:FadingComboBox.Transitions>
                        </controls:FadingComboBox>
                        <Path x:Name="VersionLoadingSpinner"
                              Classes="instancesVersionSpinner"
                              Width="18"
                              Height="18"
                              Data="M9,1 A8,8 0 1 1 1,9"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              controls:RotatingVisual.IsActive="{Binding IsVisible, RelativeSource={RelativeSource Self}}"
                              Opacity="0">
                          <Path.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                            </Transitions>
                          </Path.Transitions>
                          <Path.RenderTransform>
                            <RotateTransform />
                          </Path.RenderTransform>
                        </Path>
                    </Grid>
                  </Border>
                </controls:FormRow>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding InstanceCreationError}"
                       Margin="4,0"
                       Foreground="{DynamicResource DangerSoftBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasInstanceCreationError}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Spacing="10">
              <Button Classes="wizardAction cancel"
                      Command="{Binding CloseInstanceCreatorCommand}">
                <TextBlock Text="{Binding BackLabel}" />
              </Button>
              <Button Classes="wizardAction create"
                      IsEnabled="{Binding CanCreateInstance}"
                      Command="{Binding CreateInstanceCommand}">
                <TextBlock Text="{Binding CreateInstanceLabel}" />
              </Button>
            </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="InstanceDragPreview"
            Grid.ColumnSpan="2"
            Classes="managerDragPreview"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsVisible="False"
            IsHitTestVisible="False"
            ZIndex="100">
      <Border.RenderTransform>
        <TranslateTransform />
      </Border.RenderTransform>
      <Grid Classes="managerListItemLayout" ColumnDefinitions="Auto,*,22" ColumnSpacing="12">
        <Border Classes="managerListDragTarget">
          <Path Classes="managerListHandle" Data="{StaticResource DragIndicatorIcon}" />
        </Border>
        <Grid Grid.Column="1"
              Classes="managerListIdentity"
              ColumnDefinitions="Auto,*">
          <Image Classes="instancesListGameIcon"
                 Source="avares://Hyprism.Desktop/Assets/Game/grass.png"
                 Stretch="Uniform"
                 IsHitTestVisible="False" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock x:Name="InstanceDragPreviewName"
                       Classes="settingsCategoryTitle managerListTitle"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock x:Name="InstanceDragPreviewBranch"
                       Classes="managerCategoryDescription"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>
        </Grid>
        <Path Grid.Column="2"
              Classes="managerListMore"
              Data="{StaticResource MoreVerticalIcon}" />
      </Grid>
    </Border>
  </Grid>

    <controls:OverlayModal x:Name="ModCatalogModal"
                           Classes="modCatalogModal"
                           IsOpen="{Binding HasModCatalogPreview}"
                           DismissCommand="{Binding CloseModCatalogPreviewCommand}"
                           Closed="OnModCatalogModalClosed"
                           ZIndex="200">
      <controls:OverlayModal.ModalContent>
      <Grid Classes="instanceModPreview modalSheet">
        <Border Classes="instanceModPreviewContent">
          <Grid RowDefinitions="Auto,*" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding SelectedModCatalogPreview.Name}"
                       FontSize="22"
                       FontWeight="Bold"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Classes="instancePreviewClose"
                    Command="{Binding CloseModCatalogPreviewCommand}"
                    ToolTip.Tip="{Binding ModCatalogPreviewCloseLabel}">
              <Path Data="{StaticResource CloseIcon}" />
            </Button>
          </Grid>

          <controls:SmoothScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="0,0,8,0">
              <Border Classes="instancePreviewHero modalHero">
                <Grid>
                  <Image Width="64"
                         Height="64"
                         Opacity="0.28"
                         Source="{Binding SelectedModCatalogPreview.Icon}"
                         IsVisible="{Binding !HasModCatalogPreviewImage}"
                         Stretch="Uniform" />
                  <Image Classes="instancePreviewHeroImage"
                         Classes.loaded="{Binding IsModCatalogPreviewImageVisible}"
                         Source="{Binding ModCatalogPreviewImage}"
                         Stretch="UniformToFill" />
                  <Border Classes="modPreviewHeroSkeleton"
                          IsVisible="{Binding IsModCatalogPreviewImageLoading}" />
                  <Border Classes="instancePreviewImageSwitch"
                          ZIndex="1"
                          IsVisible="{Binding HasMultipleModCatalogPreviewScreenshots}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="instancePreviewImageButton"
                              IsEnabled="{Binding CanShowPreviousModCatalogScreenshot}"
                              Command="{Binding ShowPreviousModCatalogScreenshotCommand}">
                        <Viewbox Classes="instancePreviewImageSymbol"
                                 RenderTransformOrigin="50%,50%">
                          <Viewbox.RenderTransform>
                            <RotateTransform Angle="180" />
                          </Viewbox.RenderTransform>
                          <Canvas Width="960" Height="960">
                            <Path Classes="instancePreviewImageGlyph"
                                  Data="{StaticResource NextIcon}">
                              <Path.RenderTransform>
                                <TranslateTransform Y="960" />
                              </Path.RenderTransform>
                            </Path>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Classes="instancePreviewImageButton"
                              IsEnabled="{Binding CanShowNextModCatalogScreenshot}"
                              Command="{Binding ShowNextModCatalogScreenshotCommand}">
                        <Viewbox Classes="instancePreviewImageSymbol">
                          <Canvas Width="960" Height="960">
                            <Path Classes="instancePreviewImageGlyph"
                                  Data="{StaticResource NextIcon}">
                              <Path.RenderTransform>
                                <TranslateTransform Y="960" />
                              </Path.RenderTransform>
                            </Path>
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <TextBlock Text="{Binding SelectedModCatalogPreview.Summary}"
                         Classes="instancePreviewSummary"
                         TextWrapping="Wrap" />

              <Border Classes="managerInfoGroup modPreviewInfoGroup">
                <Grid ColumnDefinitions="*,2,*">
                  <Border Classes="managerInfoCell">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding ModCatalogPreviewAuthorLabel}" Classes="managerInfoLabel" />
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Classes="instanceCatalogAuthorAvatar modalAuthorAvatar">
                          <Grid>
                            <TextBlock Text="{Binding SelectedModCatalogPreview.AuthorInitial}"
                                       IsVisible="{Binding !SelectedModCatalogPreview.ShowsAuthorAvatar}" />
                            <Image Source="{Binding SelectedModCatalogPreview.AuthorAvatar}"
                                   IsVisible="{Binding SelectedModCatalogPreview.ShowsAuthorAvatar}"
                                   Stretch="UniformToFill" />
                          </Grid>
                        </Border>
                        <TextBlock Text="{Binding SelectedModCatalogPreview.Author}"
                                   Classes="managerInfoValue"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" />
                  <Border Grid.Column="2" Classes="managerInfoCell">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding ModCatalogPreviewDownloadsLabel}" Classes="managerInfoLabel" />
                      <TextBlock Text="{Binding SelectedModCatalogPreview.DownloadCountLabel}"
                                 Classes="managerInfoValue" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Grid>
                <StackPanel Classes="modPreviewContent"
                            Classes.revealed="{Binding IsModCatalogPreviewFilesContentVisible}"
                            Spacing="6">
                  <TextBlock Text="{Binding ModCatalogPreviewNoFilesLabel}"
                             Classes="muted"
                             FontSize="12"
                             IsVisible="{Binding !HasModCatalogPreviewFiles}" />
                  <Border Classes="instancePreviewVersionTable formGroup settingsGroup"
                          IsVisible="{Binding HasModCatalogPreviewFiles}">
                    <StackPanel>
                      <Border Classes="dataTableHeader">
                        <Grid ColumnDefinitions="1*,2.2*,1.5*" ColumnSpacing="16">
                          <TextBlock Text="{Binding ModCatalogFileTypeColumn}" />
                          <TextBlock Grid.Column="1" Text="{Binding ModCatalogFileNameColumn}" />
                          <TextBlock Grid.Column="2" Text="{Binding ModCatalogFileGameVersionsColumn}" />
                        </Grid>
                      </Border>
                      <ItemsControl Classes="instancePreviewFiles"
                                    ItemsSource="{Binding ModCatalogPreviewFiles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="instances:ModCatalogFileItemViewModel">
                            <Button Classes="instancePreviewFile tableRow"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.incompatible="{Binding IsIncompatible}"
                                    IsEnabled="{Binding CanSelect}"
                                    Command="{Binding DataContext.SelectModCatalogPreviewFileCommand, ElementName=InstancesRoot}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="1*,2.2*,1.5*" ColumnSpacing="16">
                                <Border Classes="modPreviewReleaseBadge"
                                        Classes.release="{Binding IsRelease}"
                                        Classes.beta="{Binding IsBeta}"
                                        Classes.alpha="{Binding IsAlpha}">
                                  <TextBlock Text="{Binding ReleaseLabel}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Classes="dataTableValue link"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding GameVersionsLabel}"
                                           Classes="dataTableValue"
                                           TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <StackPanel Classes="modPreviewFilesSkeleton"
                            Classes.fading="{Binding IsModCatalogPreviewFilesSkeletonFadingOut}"
                            IsVisible="{Binding IsModCatalogPreviewFilesSkeletonVisible}"
                            Spacing="6">
                  <Border Classes="contentSkeletonCard" Padding="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="5">
                        <Border Classes="contentTextSkeleton phase1" Height="12" Width="230" HorizontalAlignment="Left" />
                        <Border Classes="contentTextSkeleton phase2" Height="9" Width="130" HorizontalAlignment="Left" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <Border Classes="contentTextSkeleton phase3" Height="14" Width="64" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="contentSkeletonCard" Padding="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="5">
                        <Border Classes="contentTextSkeleton phase2" Height="12" Width="185" HorizontalAlignment="Left" />
                        <Border Classes="contentTextSkeleton phase3" Height="9" Width="100" HorizontalAlignment="Left" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <Border Classes="contentTextSkeleton phase1" Height="14" Width="52" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="contentSkeletonCard" Padding="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="5">
                        <Border Classes="contentTextSkeleton phase3" Height="12" Width="255" HorizontalAlignment="Left" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <Border Classes="contentTextSkeleton phase2" Height="14" Width="58" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>

              <Border Classes="modPreviewSplitAction">
                <Grid ColumnDefinitions="1*,2,1.25*">
                  <Button Classes="instanceInstall preview splitMain"
                          Classes.active="{Binding SelectedModCatalogPreview.IsInstalling}"
                          IsEnabled="{Binding CanInstallModCatalogPreview}"
                          Command="{Binding InstallModCatalogPreviewCommand}">
                    <Grid Classes="managedActionContent">
                      <StackPanel Classes="managedActionIdle"
                                  Orientation="Horizontal"
                                  Spacing="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding !SelectedModCatalogPreviewFile.IsInstalled}">
                        <Path Classes="managerCompactActionIcon"
                              Data="{StaticResource DownloadIcon}" />
                        <TextBlock Text="{Binding InstallLabel}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" />
                      </StackPanel>
                      <StackPanel Classes="managedActionIdle"
                                  Orientation="Horizontal"
                                  Spacing="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding SelectedModCatalogPreviewFile.IsInstalled}">
                        <Path Classes="instanceInstalledCheck" Data="{StaticResource CheckIcon}" />
                        <TextBlock Text="{Binding InstalledLabel}" />
                      </StackPanel>
                      <Grid Classes="managedActionProgress"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Classes="managedActionSpinner"
                              controls:RotatingVisual.IsActive="{Binding SelectedModCatalogPreview.IsInstalling}"
                              Data="M10,2 A8,8 0 1 1 2,10" />
                      </Grid>
                    </Grid>
                  </Button>
                  <Border Grid.Column="1" Classes="modPreviewSplitDivider" />
                  <Button Grid.Column="2"
                          Classes="modPreviewCurseForgeAction"
                          Command="{Binding OpenCatalogModPageCommand}"
                          CommandParameter="{Binding SelectedModCatalogPreview}">
                    <Grid Height="42" HorizontalAlignment="Stretch">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                        <Path Classes="modPreviewCurseForgeIcon"
                              Data="{StaticResource CurseForgeBrandIcon}">
                          <Path.RenderTransform>
                            <TranslateTransform Y="5" />
                          </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="{Binding ModCatalogOpenCurseForgeLabel}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </controls:SmoothScrollViewer>
          </Grid>
        </Border>

        <Border Classes="instanceModPreviewBodyOutline" />
      </Grid>
      </controls:OverlayModal.ModalContent>
    </controls:OverlayModal>

    <controls:OverlayModal x:Name="ModCatalogInstallModal"
                           Classes="modCatalogInstallModal"
                           IsOpen="{Binding HasModCatalogInstallConfirmation}"
                           DismissCommand="{Binding CloseModCatalogInstallConfirmationCommand}"
                           Closed="OnModCatalogInstallModalClosed"
                           ZIndex="210">
      <controls:OverlayModal.ModalContent>
        <Grid Classes="instanceModPreview modalSheet">
          <Border Classes="instanceModPreviewContent">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding ModCatalogInstallPreviewTitle}"
                           FontSize="22"
                           FontWeight="Bold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="instancePreviewClose"
                        Command="{Binding CloseModCatalogInstallConfirmationCommand}"
                        ToolTip.Tip="{Binding ModCatalogPreviewCloseLabel}">
                  <Path Data="{StaticResource CloseIcon}" />
                </Button>
              </Grid>

              <controls:SmoothScrollViewer Grid.Row="1"
                                           HorizontalScrollBarVisibility="Disabled"
                                           VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding ModCatalogInstallDependencyHint}"
                             Classes="dataTableValue"
                             TextWrapping="Wrap" />
                  <Border x:Name="ModCatalogInstallTable"
                          Classes="instancePreviewVersionTable modCatalogInstallTable">
                    <StackPanel>
                    <Border Classes="dataTableHeader">
                      <Grid ColumnDefinitions="2*,1.1*,1.1*" ColumnSpacing="16">
                        <TextBlock Text="{Binding ModCatalogFileNameColumn}" />
                        <TextBlock Grid.Column="1" Text="{Binding ModCatalogInstallVersionColumn}" />
                        <TextBlock Grid.Column="2" Text="{Binding ModCatalogInstallDependenciesColumn}" />
                      </Grid>
                    </Border>
                    <ItemsControl Classes="instancePreviewFiles"
                                  ItemsSource="{Binding ModCatalogInstallItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="instances:ModCatalogInstallItemViewModel">
                          <Border Classes="modCatalogInstallTableRow">
                            <Grid ColumnDefinitions="2*,1.1*,1.1*" ColumnSpacing="16">
                              <Grid ColumnDefinitions="38,*" ColumnSpacing="16">
                                <Border Classes="modCatalogInstallIcon">
                                  <Grid>
                                    <TextBlock Text="{Binding Initial}"
                                               IsVisible="{Binding !ShowsIcon}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding Icon}"
                                           IsVisible="{Binding ShowsIcon}"
                                           Stretch="UniformToFill"
                                           ClipToBounds="True" />
                                  </Grid>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Classes="dataTableValue link"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                              </Grid>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Version}"
                                         Classes="dataTableValue"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <Border Grid.Column="2"
                                      x:Name="ModCatalogDependencyBadge"
                                      Classes="versionBadge modCatalogDependencyBadge"
                                      IsVisible="{Binding HasDependencies}">
                                <TextBlock Text="{Binding DependenciesLabel}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                              </Border>
                              <controls:FadingPopup Grid.Column="2"
                                                    Placement="Top"
                                                    PlacementTarget="ModCatalogDependencyBadge"
                                                    VerticalOffset="-8"
                                                    IsHoverEnabled="True">
                                <Border Classes="modCatalogDependencyPopup">
                                  <controls:SmoothScrollViewer MaxHeight="240"
                                                               HorizontalScrollBarVisibility="Disabled"
                                                               VerticalScrollBarVisibility="Auto"
                                                               IsScrollChainingEnabled="False">
                                    <ItemsControl ItemsSource="{Binding DependencyItems}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="instances:ModCatalogDependencyItemViewModel">
                                          <Grid ColumnDefinitions="32,*"
                                                ColumnSpacing="9"
                                                MinHeight="36"
                                                Margin="0,2">
                                            <Border Classes="modCatalogDependencyIcon">
                                              <Grid>
                                                <TextBlock Text="{Binding Initial}"
                                                           IsVisible="{Binding !ShowsIcon}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}"
                                                       IsVisible="{Binding ShowsIcon}"
                                                       Stretch="UniformToFill"
                                                       ClipToBounds="True" />
                                              </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Classes="modCatalogDependencyDetails"
                                                       MaxLines="2"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       LineHeight="15"
                                                       VerticalAlignment="Center">
                                              <Run Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                              <Run Text=" " />
                                              <Run Text="{Binding VersionInParentheses}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontWeight="Normal" />
                                            </TextBlock>
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </controls:SmoothScrollViewer>
                                </Border>
                              </controls:FadingPopup>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </controls:SmoothScrollViewer>

              <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button x:Name="ModCatalogInstallResetButton"
                        Classes="dataAddAction modCatalogInstallResetAction"
                        Command="{Binding ClearModCatalogSelectionCommand}"
                        ToolTip.Tip="{Binding InstanceModsClearSelectionLabel}"
                        VerticalAlignment="Center">
                  <Path Classes="dataActionIcon" Data="{StaticResource RefreshIcon}" />
                </Button>
                <Button x:Name="ModCatalogInstallConfirmButton"
                        Grid.Column="1"
                        Classes="instanceInstall modCatalogInstallConfirmAction"
                        IsEnabled="{Binding CanInstallSelectedCatalogMods}"
                        Command="{Binding InstallSelectedCatalogModsCommand}"
                        HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding InstallLabel}" />
                </Button>
              </Grid>
            </Grid>
          </Border>

          <Border Classes="instanceModPreviewBodyOutline" />
        </Grid>
      </controls:OverlayModal.ModalContent>
    </controls:OverlayModal>
  </Grid>
</UserControl>
