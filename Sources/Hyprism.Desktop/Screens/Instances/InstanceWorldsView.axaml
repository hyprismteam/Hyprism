<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:instances="using:Hyprism.Desktop.Screens.Instances"
             xmlns:controls="using:Hyprism.Desktop.Controls"
             x:Class="Hyprism.Desktop.Screens.Instances.InstanceWorldsView"
             x:Name="InstanceWorldsRoot"
             x:DataType="instances:InstancesViewModel">
  <Grid IsVisible="{Binding IsDisplayedInstanceWorldsSection}"
        MaxWidth="{x:Static instances:InstanceModsView.ModCatalogContentMaxWidth}"
        HorizontalAlignment="Stretch">
    <Border Classes="instanceContentPanel catalog">
      <Grid>
        <Path Classes="instanceToolbarSpinner"
              Data="M9,1 A8,8 0 1 1 1,9"
              IsVisible="{Binding IsInstanceWorldsInitialLoading}"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              controls:RotatingVisual.IsActive="{Binding IsInstanceWorldsInitialLoading}" />
        <StackPanel IsVisible="{Binding IsInstanceWorldsEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="20" Spacing="9">
          <Image Width="48" Height="48" Source="avares://Hyprism.Desktop/Assets/Fluent/map.png" />
          <TextBlock Text="{Binding InstanceWorldsEmptyTitle}" FontSize="19" FontWeight="SemiBold"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding InstanceWorldsEmptyHint}" Classes="muted" MaxWidth="400"
                     TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="InstanceWorldsList" IsVisible="{Binding HasInstanceWorlds}"
                 ItemsSource="{Binding InstanceWorlds}" Classes="instanceVirtualizedList"
                 Margin="10,10,10,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="instances:InstanceWorldItemViewModel">
              <Border Classes="instanceModRow catalog">
                <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="12">
                  <Border Classes="instanceModIcon instanceWorldPreview" ClipToBounds="True">
                    <Panel>
                      <Image Source="{Binding Preview}" Stretch="UniformToFill"
                             IsVisible="{Binding HasPreview}" />
                      <PathIcon Width="32" Height="32" Data="{StaticResource MapRoundedIcon}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !HasPreview}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding LastModified}" Classes="muted" FontSize="12"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                      <Border Classes="instanceCatalogAuthorBadge" Padding="7,3">
                        <TextBlock Text="{Binding Size}" Classes="instanceCatalogAuthorName" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>
                  <Button Grid.Column="2" Classes="managerCompactActionPart menu standalone worldOptions"
                          VerticalAlignment="Center" Click="OnWorldOptionsClicked"
                          AutomationProperties.Name="{Binding Name}">
                    <PathIcon Classes="managerCompactActionMenuIcon" Data="{StaticResource MoreVerticalIcon}" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <controls:FadingPopup x:Name="WorldOptionsPopup" Placement="BottomEdgeAlignedRight" VerticalOffset="8">
      <Border Classes="uiPopupSurface managerCompactActionFlyout">
        <StackPanel Spacing="2">
          <Button Classes="managerCompactMenuAction" Click="OnOpenWorldFolderClicked">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="managerCompactMenuIcon" Data="{StaticResource FolderOpenIcon}" />
              <TextBlock Text="{Binding WorldOpenFolderLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="managerCompactMenuAction danger" IsEnabled="{Binding CanDeleteWorld}"
                  Click="OnDeleteWorldClicked">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="managerCompactMenuIcon" Data="{StaticResource DeleteIcon}" />
              <TextBlock Text="{Binding InstanceModsDeleteLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </controls:FadingPopup>
  </Grid>
</UserControl>
