<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:easing="using:Avalonia.Animation.Easings"
        xmlns:controls="using:Hyprism.Desktop.Controls"
        xmlns:settings="using:Hyprism.Desktop.Screens.Settings">
  <!-- Selectors owned by the Settings screen -->

  <Style Selector="Border.settingsRail">
    <Setter Property="Background" Value="{DynamicResource NavigationPaneBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>






  <Style Selector="Border.settingsCategoryIconFrame">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <Style Selector="Image.settingsCategoryIcon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
  </Style>






  <Style Selector="Border.settingsRail.compact">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <Style Selector="TextBlock.settingsCategoryHeading">
    <Setter Property="Margin" Value="4,0,4,2" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Grid.settingsHeaderAction">
    <Setter Property="ColumnSpacing" Value="16" />
    <Setter Property="Margin" Value="4,0,4,2" />
  </Style>
  <Style Selector="Grid.settingsHeaderAction TextBlock.settingsCategoryHeading">
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Grid.settingsHeaderAction Button.dataAddAction">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBlock.settingsHeaderActionLabel">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.dataWarning">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="#18FFC54D" />
    <Setter Property="BorderBrush" Value="#36FFC54D" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Path.dataWarningIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.dataWarningText">
    <Setter Property="Foreground" Value="#F2D391" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.formRow.dataFileRow">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="18,16" />
  </Style>

  <Style Selector="TextBlock.storageTotalValue">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.storageTotalLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.storageUsageCard">
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="TextBlock.storageTotalValue.storageUsageValue">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="ProgressBar.storageLoadingProgress">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlTrackBrush}" />
  </Style>

  <Style Selector="Border.storageLegendCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.storageLegendItem">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
  </Style>

  <Style Selector="TextBlock.storageLegendLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.storageLegendPercent">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.storageLegendSize">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Border.storageLegendCount">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="#18FFFFFF" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="Border.storageLegendCount TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.dataPathSurface">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="14,4,5,4" />
    <Setter Property="Background" Value="{DynamicResource SegmentedTrackBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="TextBlock.dataPathText">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="JetBrains Mono" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.dataPathText.placeholder">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource GoogleSansFont}" />
  </Style>





  <Style Selector="Border.formRow.runtime">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.formRow.mirrorSourceRow">
    <Setter Property="MinHeight" Value="74" />
  </Style>

  <Style Selector="settings|SettingsView Border.sourceMoreTarget">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="settings|SettingsView Path.sourceMoreIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="settings|SettingsView Border.sourceActionFlyout">
    <Setter Property="Width" Value="220" />
  </Style>

  <Style Selector="settings|SettingsView Button.sourceMenuAction">
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="settings|SettingsView Button.sourceMenuAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
  </Style>

  <Style Selector="settings|SettingsView Button.sourceMenuAction.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerSoftBrush}" />
  </Style>

  <Style Selector="settings|SettingsView Path.sourceMenuIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>





  <Style Selector="settings|SettingsView RadioButton.authServerRadio">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Grid.sourceAvailability">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Grid.sourceAvailabilityState">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 8px)" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26">
          <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Grid.sourceAvailability.checking Grid.sourceAvailabilityState.checking, Grid.sourceAvailability.available Grid.sourceAvailabilityState.available, Grid.sourceAvailability.noVersions Grid.sourceAvailabilityState.noVersions, Grid.sourceAvailability.unavailable Grid.sourceAvailabilityState.unavailable">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>

  <Style Selector="Grid.sourceAvailability.available Grid.sourceAvailabilityState.checking, Grid.sourceAvailability.noVersions Grid.sourceAvailabilityState.checking, Grid.sourceAvailability.unavailable Grid.sourceAvailabilityState.checking">
    <Setter Property="RenderTransform" Value="translate(0px, -8px)" />
  </Style>

  <Style Selector="Path.sourceAvailabilitySpinner">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="PathIcon.sourceAvailabilityIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="PathIcon.emptyStateIcon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="PathIcon.sourceAvailabilityIcon.available">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="PathIcon.sourceAvailabilityIcon.noVersions">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="PathIcon.sourceAvailabilityIcon.unavailable">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>










  <Style Selector="Button.mirrorRemove">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="#72757B" />
  </Style>

  <Style Selector="Button.mirrorRemove:pointerover">
    <Setter Property="Foreground" Value="#EF9999" />
    <Setter Property="Background" Value="Transparent" />
  </Style>





  <Style Selector="ProgressBar.sourceProgress">
    <Setter Property="Height" Value="2" />
    <Setter Property="Margin" Value="18,0" />
    <Setter Property="Foreground" Value="#7DCCA0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="TextBlock.sourceOperationStatus, TextBlock.sourceOperationError">
    <Setter Property="Margin" Value="4,2,4,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.sourceOperationStatus">
    <Setter Property="Foreground" Value="#86D2A0" />
  </Style>

  <Style Selector="TextBlock.sourceOperationError">
    <Setter Property="Foreground" Value="#EE9A9A" />
  </Style>

  <Style Selector="Border.formRow.aboutRow">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.aboutLink">
    <Setter Property="MinHeight" Value="66" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.aboutLink:pointerover">
    <Setter Property="Background" Value="#0AFFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.aboutLink:pressed">
    <Setter Property="Background" Value="#10FFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Path.aboutOpenIcon">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.aboutLink:pointerover Path.aboutOpenIcon">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Border.aboutTeamGroup">
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style Selector="Button.aboutTeamMember">
    <Setter Property="MinHeight" Value="82" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.aboutTeamMember:pointerover">
    <Setter Property="Background" Value="#0AFFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.aboutTeamMember:pressed">
    <Setter Property="Background" Value="#10FFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Border.aboutTeamAvatar">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="#24B59CFF" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.aboutTeamAvatar TextBlock">
    <Setter Property="Foreground" Value="#E7E0FF" />
  </Style>

  <Style Selector="TextBlock.aboutTeamRole">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Border.aboutContributorsGroup">
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Button.aboutContributor">
    <Setter Property="Width" Value="58" />
    <Setter Property="Height" Value="58" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.aboutContributor:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.aboutContributor:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Border.aboutContributorAvatar">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="#24B59CFF" />
  </Style>

  <Style Selector="Border.aboutContributorAvatar.overflow">
    <Setter Property="Background" Value="#18FFFFFF" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.aboutContributorAvatar.overflow TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.aboutContributor.overflow:pointerover Border.aboutContributorAvatar">
    <Setter Property="Background" Value="#28FFFFFF" />
  </Style>



  <Style Selector="TextBlock.aboutDisclaimer">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <Style Selector="StackPanel.aboutTechnologyAttribution">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,6,0,12" />
  </Style>

  <Style Selector="TextBlock.aboutTechnologyCaption">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.aboutTechnologyLogo">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
          <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.aboutTechnologyLogo /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.aboutTechnologyLogo:pointerover, Button.aboutTechnologyLogo:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="scale(1.07)" />
  </Style>

  <Style Selector="Path.aboutTechnologyAvaloniaMark">
    <Setter Property="Width" Value="35" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="#797A80" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.aboutTechnologyLogo.avalonia:pointerover Path.aboutTechnologyAvaloniaMark">
    <Setter Property="Fill" Value="#007DF9" />
  </Style>

  <Style Selector="Path.aboutTechnologyDotNetBackground, Path.aboutTechnologyDotNetWordmark">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Path.aboutTechnologyDotNetBackground">
    <Setter Property="Fill" Value="#797A80" />
  </Style>

  <Style Selector="Path.aboutTechnologyDotNetWordmark">
    <Setter Property="Fill" Value="#191A1D" />
  </Style>

  <Style Selector="Button.aboutTechnologyLogo.dotnet:pointerover Path.aboutTechnologyDotNetBackground">
    <Setter Property="Fill" Value="#512BD4" />
  </Style>

  <Style Selector="Button.aboutTechnologyLogo.dotnet:pointerover Path.aboutTechnologyDotNetWordmark">
    <Setter Property="Fill" Value="#FFFFFF" />
  </Style>

  <Style Selector="TextBlock.aboutTechnologyDisclaimer">
    <Setter Property="MaxWidth" Value="620" />
    <Setter Property="Margin" Value="12,2,12,0" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>



  <Style Selector="RadioButton.javaRuntimeOption">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="RadioButton.javaRuntimeOption:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavigationItemHoverBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="RadioButton.javaRuntimeOption:pressed">
    <Setter Property="Background" Value="#10FFFFFF" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="RadioButton.javaRuntimeOption:checked">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.customJavaExpander">
    <Setter Property="MaxHeight" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="RenderTransform" Value="translateY(-8px)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="MaxHeight" Duration="0:0:0.26" Easing="CubicEaseOut" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.customJavaExpander.open">
    <!-- Tight cap around the real content height (path surface 44 plus the
         10 and 14 margins) so opening tracks the full duration the same way
         closing does instead of finishing early -->
    <Setter Property="MaxHeight" Value="68" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
  </Style>









  <Style Selector="TextBlock.javaMemoryValue">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>



  <Style Selector="Button.settingsAction">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="#111214" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.settingsAction:pointerover">
    <Setter Property="Background" Value="#E1E2E5" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.settingsAction:pressed">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="settings|SettingsView Button.instanceFolderChangeAction">
    <Setter Property="Width" Value="110" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.32">
          <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView Button.instanceFolderChangeAction.active, settings|SettingsView Button.instanceFolderChangeAction.active:pointerover">
    <Setter Property="Width" Value="220" />
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="#111214" />
  </Style>

  <Style Selector="settings|SettingsView Button.instanceFolderChangeAction.active.cancelArmed:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerActionBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="settings|SettingsView Button.authServerAddAction.active, settings|SettingsView Button.authServerAddAction.active:pointerover">
    <Setter Property="Width" Value="272" />
  </Style>

  <!-- The custom Java action mirrors the instance folder button and fades plus
       slides in and out with the runtime selection instead of popping -->
  <!-- The button floats over the row instead of sharing its layout, so the
       runtime option highlight always reaches the row edge and the button
       itself only ever changes through a plain nonlinear opacity fade -->
  <Style Selector="settings|SettingsView Border.customJavaPathActionHost">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.25">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView Border.customJavaPathActionHost.open">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>

  <Style Selector="settings|SettingsView Button.instanceFolderChangeAction.active Grid.managedActionContent">
    <Setter Property="Width" Value="188" />
    <Setter Property="MinWidth" Value="188" />
    <Setter Property="MaxWidth" Value="188" />
  </Style>

  <Style Selector="settings|SettingsView TextBlock.managedActionMetric">
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>





  <Style Selector="settings|SettingsView TextBox">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="settings|SettingsView controls|ModalTextField TextBox">
    <Setter Property="Padding" Value="12,9,44,9" />
  </Style>

  <Style Selector="settings|SettingsView TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="settings|SettingsView TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="settings|SettingsView TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceActiveBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="settings|SettingsView controls|ModalTextField:error TextBox /template/ Border#PART_BorderElement,
                  settings|SettingsView controls|ModalTextField:error TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
  </Style>

  <Style Selector="settings|SettingsView controls|ModalTextField:error TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource DangerSurfaceHoverBrush}" />
  </Style>

  <Style Selector="settings|SettingsView controls|ModalTextField:error TextBox:pointerover:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
  </Style>

  <!-- Screen-specific wizard styles -->

  <Style Selector="settings|SettingsView Border.sourceWizardChoiceIcon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="settings|SettingsView Border.sourceWizardChoiceIcon Path">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="settings|SettingsView TextBox.sourceJsonEditor">
    <Setter Property="Height" Value="260" />
    <Setter Property="FontFamily" Value="monospace" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="settings|SettingsView Border.sourceDeleteConfirmation">
    <Setter Property="Width" Value="320" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceActiveBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
  </Style>
</Styles>
