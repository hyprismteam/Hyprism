<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:news="using:Hyprism.Desktop.Screens.News"
             xmlns:controls="using:Hyprism.Desktop.Controls"
             xmlns:easing="using:Avalonia.Animation.Easings"
             xmlns:lottie="clr-namespace:Avalonia.Labs.Lottie;assembly=Avalonia.Labs.Lottie"
             x:Class="Hyprism.Desktop.Screens.News.NewsView"
             x:DataType="news:NewsViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Hyprism.Desktop/Screens/News/NewsArticleTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="NewsReaderTemplate" x:DataType="news:NewsViewModel">
      <Grid Background="{DynamicResource SurfaceBrush}" RowDefinitions="Auto,*">
        <Border Classes="detailToolbar"
                Classes.compact="{Binding IsCompactNewsLayout}"
                Classes.scrolled="{Binding IsNewsArticleScrolled}"
                IsVisible="{Binding IsCompactNewsLayout}">
          <Grid ColumnDefinitions="*,Auto,*">
            <Button Classes="detailBack"
                    HorizontalAlignment="Left"
                    Click="OnCompactNewsBackClicked">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Width="12"
                      Height="12"
                      Stretch="Uniform"
                      RenderTransformOrigin="50%,50%"
                      Data="{StaticResource NextIcon}">
                  <Path.RenderTransform>
                    <RotateTransform Angle="180" />
                  </Path.RenderTransform>
                </Path>
                <TextBlock Text="{Binding BackLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Classes="detailToolbarTitle"
                       Text="{Binding NewsArticleDisplayTitle}"
                       Margin="12,0"
                       MaxWidth="420"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <Button Grid.Column="2"
                    Classes="articleAction"
                    HorizontalAlignment="Right"
                    Command="{Binding SelectedNewsItem.OpenExternalCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Text="{Binding OpenOriginalLabel}" />
                <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource OpenIcon}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsNewsArticleEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="320"
                    Spacing="12">
          <Path Width="42"
                Height="42"
                HorizontalAlignment="Center"
                Fill="#24FFFFFF"
                Stretch="Uniform"
                Data="{StaticResource NewsFilledIcon}" />
          <TextBlock Text="{Binding SelectArticleLabel}"
                     Classes="muted"
                     TextAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1"
              IsVisible="{Binding IsNewsArticleStatusVisible}"
              Margin="24,18,24,24">
          <StackPanel IsVisible="{Binding IsNewsArticleSkeletonVisible}"
                      MaxWidth="820"
                      HorizontalAlignment="Stretch"
                      Spacing="18">
            <Border Classes="skeleton" Height="260" CornerRadius="18" />
            <Border Classes="skeleton" Height="30" Width="480" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Border Classes="skeleton" Height="12" Width="88" />
              <Border Classes="skeleton" Height="12" Width="68" />
              <Border Classes="skeleton" Height="12" Width="92" />
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Spacing="11">
              <Border Classes="skeleton" Height="12" HorizontalAlignment="Stretch" />
              <Border Classes="skeleton" Height="12" HorizontalAlignment="Stretch" />
              <Border Classes="skeleton" Height="12" Width="520" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Spacing="11">
              <Border Classes="skeleton" Height="12" HorizontalAlignment="Stretch" />
              <Border Classes="skeleton" Height="12" Width="580" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding HasNewsArticleError}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="420"
                      Spacing="12">
            <TextBlock Text="{Binding NewsArticleError}"
                       Foreground="{DynamicResource DangerSoftBrush}"
                       TextAlignment="Center" />
          </StackPanel>
        </Grid>

        <controls:SmoothScrollViewer Grid.Row="1"
                                     IsVisible="{Binding IsNewsArticleVisible}"
                                     EnableMiddleClickAutoScroll="True"
                                     IsPastTop="{Binding IsNewsArticleScrolled, Mode=TwoWay}"
                                     ScrollContextKey="{Binding SelectedNewsItem.Url}"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Classes="newsArticleScroll"
                                     IsHitTestVisible="{Binding IsNewsArticleBodyVisible}"
                                     HorizontalScrollBarVisibility="Disabled"
                                     VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820"
                      Margin="24,18,24,64"
                      HorizontalAlignment="Stretch">
            <Border Height="260" Classes="newsArticleHeader">
              <Grid>
                <Border Background="#191A1D" />
                <Image IsVisible="{Binding SelectedNewsItem.HasImage}"
                       Source="{Binding SelectedNewsItem.Image}"
                       Stretch="UniformToFill" />
                <Path IsVisible="{Binding SelectedNewsItem.HasNoImage}"
                      Width="72"
                      Height="72"
                      Margin="28"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Fill="#14FFFFFF"
                      Stretch="Uniform"
                      Data="{StaticResource NewsFilledIcon}" />
                <Border Classes="articleHeaderMask">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                      <GradientStop Color="#20000000" Offset="0" />
                      <GradientStop Color="#7C000000" Offset="0.48" />
                      <GradientStop Color="#F20A0B0D" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>

                <StackPanel Margin="24" VerticalAlignment="Bottom" Spacing="8">
                  <Button IsVisible="{Binding IsWideNewsLayout}"
                          Classes="articleAction"
                          HorizontalAlignment="Left"
                          Command="{Binding SelectedNewsItem.OpenExternalCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                      <TextBlock Text="{Binding OpenOriginalLabel}" />
                      <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource OpenIcon}" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="{Binding NewsArticleDisplayTitle}"
                             FontSize="32"
                             FontWeight="Bold"
                             MaxLines="3"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding NewsArticleDisplayMetadata}"
                             Foreground="#D1D2D6"
                             FontSize="12"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid Margin="4,30,4,0">
              <StackPanel x:Name="ArticleBodySkeleton"
                          IsVisible="{Binding IsNewsArticleBodySkeletonVisible}"
                          Classes="articleBodySkeleton"
                          Classes.fading="{Binding IsNewsArticleBodySkeletonFadingOut}"
                          Spacing="20">
                <Border Classes="contentTextSkeleton"
                        Width="340"
                        Height="27"
                        HorizontalAlignment="Left" />

                <StackPanel Spacing="10">
                  <Border Classes="contentTextSkeleton" Height="13" HorizontalAlignment="Stretch" />
                  <Border Classes="contentTextSkeleton phase2" Height="13" HorizontalAlignment="Stretch" />
                  <Border Classes="contentTextSkeleton phase3" Height="13" Width="610" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel Spacing="10">
                  <Border Classes="contentTextSkeleton phase2" Height="13" HorizontalAlignment="Stretch" />
                  <Border Classes="contentTextSkeleton phase3" Height="13" Width="560" HorizontalAlignment="Left" />
                </StackPanel>

                <Border Classes="contentSkeletonCard"
                        Padding="18"
                        HorizontalAlignment="Stretch">
                  <StackPanel Spacing="11">
                    <Border Classes="contentTextSkeleton" Height="13" Width="520" HorizontalAlignment="Left" />
                    <Border Classes="contentTextSkeleton phase2" Height="13" HorizontalAlignment="Stretch" />
                    <Border Classes="contentTextSkeleton phase3" Height="13" Width="590" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="10">
                  <Border Classes="contentTextSkeleton phase3" Height="13" HorizontalAlignment="Stretch" />
                  <Border Classes="contentTextSkeleton" Height="13" HorizontalAlignment="Stretch" />
                  <Border Classes="contentTextSkeleton phase2" Height="13" Width="470" HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>

              <StackPanel Classes="articleBody"
                          Classes.preparing="{Binding IsNewsArticleBodySkeletonVisible}"
                          Classes.revealed="{Binding IsNewsArticleBodyVisible}">
                <ItemsControl ItemsSource="{Binding SelectedNewsArticle.RenderedBlocks}"
                              ItemTemplate="{StaticResource NewsArticleBlockTemplate}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </controls:SmoothScrollViewer>
      </Grid>
    </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://Hyprism.Desktop/Screens/News/NewsStyles.axaml" />
  </UserControl.Styles>

                <Grid x:Name="NewsResponsiveLayout"
                      SizeChanged="OnNewsResponsiveSizeChanged"
                      Background="{DynamicResource SurfaceBrush}">
            <Grid x:Name="CompactNewsShell"
                  IsVisible="{Binding IsCompactNewsLayout}"
                  ColumnDefinitions="Auto,*"
                  ClipToBounds="True">
              <Border x:Name="CompactNewsFeedBackground"
                      Background="{DynamicResource SurfaceBrush}">
                <ContentControl x:Name="CompactNewsFeedHost"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource NewsFeedTemplate}" />
              </Border>

              <ContentControl x:Name="CompactArticleHost"
                              Grid.Column="1"
                              ZIndex="1"
                              Content="{Binding}"
                              ContentTemplate="{StaticResource NewsReaderTemplate}">
                <ContentControl.RenderTransform>
                  <TranslateTransform>
                    <TranslateTransform.Transitions>
                      <Transitions>
                        <DoubleTransition Property="X" Duration="0:0:0.3">
                          <DoubleTransition.Easing>
                            <easing:CubicEaseInOut />
                          </DoubleTransition.Easing>
                        </DoubleTransition>
                      </Transitions>
                    </TranslateTransform.Transitions>
                  </TranslateTransform>
                </ContentControl.RenderTransform>
              </ContentControl>
            </Grid>

            <Grid x:Name="WideNewsShell"
                  IsVisible="False"
                  ColumnDefinitions="420,*">
              <Border x:Name="WideNewsFeedBackground"
                      Background="{DynamicResource NavigationPaneBrush}">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource NewsFeedTemplate}" />
              </Border>
              <ContentControl x:Name="WideArticleHost"
                              Grid.Column="1"
                              Content="{Binding}"
                              ContentTemplate="{StaticResource NewsReaderTemplate}">
                <ContentControl.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                  </Transitions>
                </ContentControl.Transitions>
              </ContentControl>
            </Grid>
                </Grid>
</UserControl>
