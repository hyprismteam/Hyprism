<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:easing="using:Avalonia.Animation.Easings">
  <!-- Shared navigation rail and data presentation patterns -->

  <Style Selector="Button.managerRailCategory">
    <Setter Property="Height" Value="72" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.managerRailCategory:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavigationItemHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.managerRailCategory:pressed">
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.managerRailCategory.selected">
    <Setter Property="Background" Value="{DynamicResource NavigationItemSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.managerCategoryDescription">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.managerRailCategory.compact">
    <Setter Property="Height" Value="78" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.managerRailCategory.compact.selected">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.managerRailCategory.compact.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavigationItemHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.managerRailCategory.compact Border.settingsCategoryIconFrame">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0,0,14,0" />
  </Style>
  <Style Selector="Button.managerRailCategory.compact Image.settingsCategoryIcon">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
  </Style>
  <Style Selector="Button.dataPathOpen">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.dataPathOpen:pointerover">
    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.dataPathOpen:pressed">
    <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Path.dataPathOpenIcon, Path.dataActionIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.dataTableHeader">
    <Setter Property="Padding" Value="18,11" />
    <Setter Property="Background" Value="#18191B" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
  </Style>
  <Style Selector="Border.dataTableHeader TextBlock">
    <Setter Property="Foreground" Value="#777A80" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.dataTableValue">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.dataTableValue.link">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.dataAddAction, Button.sourceCancel, Button.mirrorRemove, Button.sourceRemoveConfirm">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
        <BrushTransition Property="Background" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.dataAddAction">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.dataAddAction:pointerover, Button.dataAddAction:pressed">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.versionBadge">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.versionBadge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Shared detail toolbar and loading placeholders -->

  <Style Selector="Border.contentTextSkeleton">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#16FFFFFF" Offset="0" />
        <GradientStop Color="#32FFFFFF" Offset="0.5" />
        <GradientStop Color="#16FFFFFF" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1.25" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.38" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.82" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.38" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.contentTextSkeleton.phase2">
    <Style.Animations>
      <Animation Duration="0:0:1.25" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.7" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.34" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.7" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.contentTextSkeleton.phase3">
    <Style.Animations>
      <Animation Duration="0:0:1.55" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.32" />
        </KeyFrame>
        <KeyFrame Cue="45%">
          <Setter Property="Opacity" Value="0.74" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.32" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.contentSkeletonCard">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="BorderBrush" Value="#18FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <Style Selector="Border.detailToolbar">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.detailToolbar.compact">
    <Setter Property="Margin" Value="24,18,24,12" />
    <Setter Property="MaxWidth" Value="836" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBlock.detailToolbarTitle">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.detailToolbar.compact.scrolled TextBlock.detailToolbarTitle">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.detailBack">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.detailBack:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.detailBack:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.detailBack Path">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="Button.articleAction">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"
                            IsHitTestVisible="False" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.articleAction:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.articleAction:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.articleAction Path">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- Shared manager, wizard, progress-action, toolbar, and loading patterns -->

  <Style Selector=":is(UserControl) Button.managerListItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector=":is(UserControl).compact Button.managerListItem">
    <Setter Property="Height" Value="78" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(UserControl).compact Grid.managerListItemLayout">
    <Setter Property="ColumnSpacing" Value="14" />
  </Style>
  <Style Selector=":is(UserControl) Grid.managerListIdentity">
    <Setter Property="ColumnSpacing" Value="0" />
  </Style>
  <Style Selector=":is(UserControl).compact Grid.managerListIdentity">
    <Setter Property="ColumnSpacing" Value="14" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerListItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavigationItemHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(UserControl).wide Button.managerListItem.managed">
    <Setter Property="Background" Value="{DynamicResource NavigationItemSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(UserControl).wide Button.managerListItem.managed:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavigationItemSelectedHoverBrush}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerListItem.dragging">
    <Setter Property="Opacity" Value="0.58" />
  </Style>
  <Style Selector=":is(UserControl) TextBlock.managerListTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerListDragTarget">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl).compact Border.managerListDragTarget">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
  </Style>
  <Style Selector=":is(UserControl) Path.managerListHandle,
                  :is(UserControl) Path.managerListMore">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAddRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAddRow Path">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerDragPreview">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceActiveBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
  </Style>
  <Style Selector=":is(UserControl).compact Border.managerDragPreview">
    <Setter Property="MinHeight" Value="78" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector=":is(UserControl) Border.wizardScreen,
                  :is(UserControl) Border.wizardScreen">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector=":is(UserControl).compact Border.managerWideSplitAction">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerCompactSplitAction">
    <Setter Property="Height" Value="36" />
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="#111111" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.32">
          <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart.main">
    <Setter Property="Width" Value="126" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart.main:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlKnobHoverBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart.main.active">
    <Setter Property="Width" Value="216" />
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="#111111" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart.main.active:pointerover">
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="#111111" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart.menu">
    <Setter Property="Width" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart.menu:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector=":is(UserControl) Path.managerCompactActionIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) PathIcon.managerCompactActionChevron">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerCompactActionFlyout">
    <Setter Property="Width" Value="220" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactMenuAction">
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactMenuAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactMenuAction.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector=":is(UserControl) Path.managerCompactMenuIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction">
    <Setter Property="Height" Value="50" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.34">
          <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <DoubleTransition Property="Opacity" Duration="0:0:0.24">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.primary">
    <Setter Property="Width" Value="150" />
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="#111111" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.middle">
    <Setter Property="Width" Value="170" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.last">
    <Setter Property="Width" Value="112" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.first">
    <Setter Property="CornerRadius" Value="14,0,0,14" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.last">
    <Setter Property="CornerRadius" Value="0,14,14,0" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.primary:pointerover">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#111111" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.primary.active">
    <Setter Property="Width" Value="265" />
  </Style>
  <Style Selector=":is(UserControl) StackPanel.managerWideActions.actionActive Button.managerAction.deleteAction">
    <Setter Property="Width" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.deleteAction">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.secondary.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector=":is(UserControl) Path.managerActionIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) StackPanel.managerDeleteActionContent">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerWideSplitAction">
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerWideActionDivider">
    <Setter Property="Width" Value="3" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.32">
          <DoubleTransition.Easing><easing:CubicEaseInOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(UserControl) StackPanel.managerWideActions.actionActive Border.managerWideActionDivider.deleteDivider">
    <Setter Property="Width" Value="0" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerCompactActionPart.main ContentControl,
                  :is(UserControl) Button.managerAction.primary ContentControl,
                  :is(UserControl) Button.officialSignInAction ContentControl,
                  :is(UserControl) Button.instanceFolderChangeAction ContentControl">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector=":is(UserControl) Grid.managedActionContent">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector=":is(UserControl) Button.managerAction.primary.active Grid.managedActionContent">
    <Setter Property="Width" Value="225" />
    <Setter Property="MinWidth" Value="225" />
    <Setter Property="MaxWidth" Value="225" />
  </Style>
  <Style Selector=":is(UserControl) StackPanel.managedActionIdle,
                  :is(UserControl) Grid.managedActionProgress,
                  :is(UserControl) TextBlock.managedActionCancel">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.22">
          <DoubleTransition.Easing><easing:CubicEaseOut /></DoubleTransition.Easing>
        </DoubleTransition>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26">
          <TransformOperationsTransition.Easing><easing:CubicEaseOut /></TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector=":is(UserControl) StackPanel.managedActionIdle">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>
  <Style Selector=":is(UserControl) Grid.managedActionProgress,
                  :is(UserControl) TextBlock.managedActionCancel">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 8px)" />
  </Style>
  <Style Selector=":is(UserControl) Button.active StackPanel.managedActionIdle">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, -8px)" />
  </Style>
  <Style Selector=":is(UserControl) Button.active Grid.managedActionProgress">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>
  <Style Selector=":is(UserControl) Button.active.cancelArmed:pointerover Grid.managedActionProgress">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, -8px)" />
  </Style>
  <Style Selector=":is(UserControl) Button.active.cancelArmed:pointerover TextBlock.managedActionCancel">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
  </Style>
  <Style Selector=":is(UserControl) Path.managedActionSpinner">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerInfoGroup">
    <Setter Property="Background" Value="{DynamicResource ControlGroupBrush}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerInfoCell">
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector=":is(UserControl) Border.managerInfoCell > StackPanel,
                  :is(UserControl) Border.managerInfoCell > Grid">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(UserControl) TextBlock.managerInfoLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector=":is(UserControl) TextBlock.managerInfoValue">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

</Styles>
