<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:easing="using:Avalonia.Animation.Easings">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource GoogleSansFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource GoogleSansFont}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>



  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource GoogleSansFont}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ComboBox:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Slider:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Height" Value="{DynamicResource Size.NavItem}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.Nav}" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Navigation}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.nav:pressed">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.nav Path.navIconOutline">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.nav:pointerover Path.navIconOutline">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.nav.selected Path.navIconOutline">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Button.nav Path.navIconFilled">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.nav:pointerover Path.navIconFilled">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.nav.selected Path.navIconFilled">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="MinWidth" Value="142" />
    <Setter Property="Height" Value="{DynamicResource Size.PrimaryAction}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.Primary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Action}" />
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
  </Style>

  <Style Selector="Button.primary Path.actionIcon">
    <Setter Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
    <Setter Property="StrokeThickness" Value="0" />
  </Style>

  <Style Selector="Button.window">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="RenderTransform" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.window:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.window:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.window Path.windowIcon">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.window:pointerover Path.windowIcon">
    <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>





  <Style Selector="Border.mainSceneFrame">
    <Setter Property="BorderBrush" Value="{DynamicResource MainCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.mainSceneFrame.bottomSheetOpen">
    <Setter Property="BorderThickness" Value="1,1,1,0" />
  </Style>

  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="#18FFFFFF" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Opacity" Value="0.38" />
    <Style.Animations>
      <Animation Duration="0:0:1.15" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.32" />
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.78" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.32" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>



  <!-- Shared scroll viewer chrome -->

  <Style Selector="ScrollViewer[AllowAutoHide=True] /template/ ScrollContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.ColumnSpan" Value="1" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical">
    <Setter Property="Width" Value="12" />
    <Setter Property="Margin" Value="0,12,4,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Rectangle#TrackRect">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ScrollBarPanningThumbBackground}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="RenderTransform" Value="scaleX(0.5)" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
          <TransformOperationsTransition.Easing>
            <easing:CubicEaseInOut />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical[IsExpanded=true] /template/ Thumb">
    <Setter Property="Width" Value="6" />
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackgroundColor}" />
    <Setter Property="RenderTransform" Value="scaleX(1)" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPointerOver}" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ Thumb /template/ Border">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:vertical /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal">
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="12,0,12,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ Rectangle#TrackRect">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ Thumb">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ScrollBarPanningThumbBackground}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="RenderTransform" Value="scaleY(0.5)" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
          <TransformOperationsTransition.Easing>
            <easing:CubicEaseInOut />
          </TransformOperationsTransition.Easing>
        </TransformOperationsTransition>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal[IsExpanded=true] /template/ Thumb">
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBackgroundColor}" />
    <Setter Property="RenderTransform" Value="scaleY(1)" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPointerOver}" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFillPressed}" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ Thumb /template/ Border">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ScrollViewer /template/ ScrollBar:horizontal /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
</Styles>
