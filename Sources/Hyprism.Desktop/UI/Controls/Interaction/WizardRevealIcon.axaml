<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lottie="clr-namespace:Avalonia.Labs.Lottie;assembly=Avalonia.Labs.Lottie"
        x:Class="Hyprism.Desktop.Controls.WizardRevealIcon"
        x:Name="RevealRoot"
        Width="64"
        Height="64"
        ClipToBounds="False"
        HorizontalAlignment="Center">
  <Border.RenderTransform>
    <TranslateTransform />
  </Border.RenderTransform>
  <Border x:Name="AnimationMotionTarget"
          ClipToBounds="False">
    <Border.RenderTransform>
      <TranslateTransform />
    </Border.RenderTransform>
    <lottie:Lottie x:Name="AnimationPlayer"
                   Width="64"
                   Height="64"
                   PlayBackRate="{Binding PlaybackRate, ElementName=RevealRoot}"
                   AutoPlay="True"
                   RepeatCount="1"
                   ClipToBounds="False"
                   OpacityMask="{DynamicResource TextPrimaryBrush}"
                   Stretch="Uniform" />
  </Border>
</Border>
