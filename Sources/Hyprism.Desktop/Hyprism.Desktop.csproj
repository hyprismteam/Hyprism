<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Hyprism.Desktop</AssemblyName>
    <ApplicationTitle>Hyprism Launcher</ApplicationTitle>
    <Product>Hyprism Launcher</Product>
    <TargetFramework>net10.0</TargetFramework>
    <Version>4.0.0</Version>
    <ApplicationIcon>Assets/Images/Hyprism.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <LauncherAppHostName>Hyprism Launcher</LauncherAppHostName>
    <LauncherAppHostExtension Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">.exe</LauncherAppHostExtension>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.2" />
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Labs.Lottie" Version="12.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DiscordRichPresence" Version="1.143.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hyprism.Core/Hyprism.Core.csproj" />
    <ProjectReference Include="../Hyprism.LocalNode/Hyprism.LocalNode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <Target Name="RenameLauncherBuildAppHost" AfterTargets="Build" Condition="'$(UseAppHost)' == 'true'">
    <Delete
      Files="$(TargetDir)$(LauncherAppHostName)$(LauncherAppHostExtension)"
      Condition="Exists('$(TargetDir)$(AssemblyName)$(LauncherAppHostExtension)') And Exists('$(TargetDir)$(LauncherAppHostName)$(LauncherAppHostExtension)')" />
    <Move
      SourceFiles="$(TargetDir)$(AssemblyName)$(LauncherAppHostExtension)"
      DestinationFiles="$(TargetDir)$(LauncherAppHostName)$(LauncherAppHostExtension)"
      Condition="Exists('$(TargetDir)$(AssemblyName)$(LauncherAppHostExtension)')" />
  </Target>

  <Target Name="RenameLauncherPublishAppHost" AfterTargets="Publish" Condition="'$(UseAppHost)' == 'true'">
    <Delete
      Files="$(PublishDir)$(LauncherAppHostName)$(LauncherAppHostExtension)"
      Condition="Exists('$(PublishDir)$(AssemblyName)$(LauncherAppHostExtension)') And Exists('$(PublishDir)$(LauncherAppHostName)$(LauncherAppHostExtension)')" />
    <Move
      SourceFiles="$(PublishDir)$(AssemblyName)$(LauncherAppHostExtension)"
      DestinationFiles="$(PublishDir)$(LauncherAppHostName)$(LauncherAppHostExtension)"
      Condition="Exists('$(PublishDir)$(AssemblyName)$(LauncherAppHostExtension)')" />
  </Target>

</Project>
